#!/bin/bash
# Mirror Bridge Doctor - Diagnose setup issues
# Usage: mirror_bridge_doctor [--verbose] [--fix]

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

# Options
VERBOSE=0
FIX_MODE=0
JSON_MODE=0

# Counters
CHECKS_PASSED=0
CHECKS_FAILED=0
CHECKS_WARNED=0

# JSON accumulation: one object per check, joined at the end. In JSON mode
# all pretty-printing is suppressed so stdout carries exactly one JSON
# object (the contract shared with `mirror_bridge generate --json`).
CHECKS_JSON=""
CURRENT_SECTION=""

json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

json_record() {
    # $1 = status (pass|warn|fail), $2 = check text, $3 = hint
    CHECKS_JSON+="{\"section\":\"$(json_escape "$CURRENT_SECTION")\",\"status\":\"$1\",\"check\":\"$(json_escape "$2")\",\"hint\":\"$(json_escape "${3:-}")\"},"
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        --fix)
            FIX_MODE=1
            shift
            ;;
        --json)
            JSON_MODE=1
            shift
            ;;
        -h|--help)
            cat << EOF
Mirror Bridge Doctor - Diagnose setup issues

Usage: mirror_bridge_doctor [options]

Options:
  -v, --verbose    Show detailed output for each check
  --fix            Attempt to fix common issues (experimental)
  --json           Emit one JSON object on stdout instead of pretty output
  -h, --help       Show this help message

Checks performed:
  - C++ compiler with reflection support
  - Python development files and version
  - Lua development files (optional)
  - Node.js and npm (optional)
  - Required environment variables
  - Library paths
  - Docker container status (if applicable)

Example:
  mirror_bridge_doctor           # Run all diagnostics
  mirror_bridge_doctor --verbose # Show detailed output

EOF
            exit 0
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            exit 1
            ;;
    esac
done

# In JSON mode stdout must carry only the final JSON object: park the real
# stdout on fd 3 and route everything else (including stray echoes from
# verbose paths) to stderr.
if [ $JSON_MODE -eq 1 ]; then
    exec 3>&1 1>&2
fi

if [ $JSON_MODE -eq 0 ]; then
    echo -e "${BOLD}${BLUE}=======================================${NC}"
    echo -e "${BOLD}${BLUE}  Mirror Bridge Doctor${NC}"
    echo -e "${BOLD}${BLUE}=======================================${NC}"
    echo ""
fi

# Helper functions
check_pass() {
    [ $JSON_MODE -eq 0 ] && echo -e "${GREEN}✓${NC} $1"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
    json_record "pass" "$1" ""
}

check_fail() {
    if [ $JSON_MODE -eq 0 ]; then
        echo -e "${RED}✗${NC} $1"
        if [ -n "$2" ]; then
            echo -e "  ${YELLOW}Hint: $2${NC}"
        fi
    fi
    CHECKS_FAILED=$((CHECKS_FAILED + 1))
    json_record "fail" "$1" "${2:-}"
}

check_warn() {
    if [ $JSON_MODE -eq 0 ]; then
        echo -e "${YELLOW}⚠${NC} $1"
        if [ -n "$2" ]; then
            echo -e "  ${BLUE}Note: $2${NC}"
        fi
    fi
    CHECKS_WARNED=$((CHECKS_WARNED + 1))
    json_record "warn" "$1" "${2:-}"
}

verbose() {
    if [ $VERBOSE -eq 1 ] && [ $JSON_MODE -eq 0 ]; then
        echo -e "  ${BLUE}$1${NC}"
    fi
}

section() {
    CURRENT_SECTION="$1"
    if [ $JSON_MODE -eq 0 ]; then
        echo ""
        echo -e "${BOLD}$1${NC}"
        echo -e "${BLUE}$(printf '%.0s─' {1..40})${NC}"
    fi
}

# ============================================================================
# Section 1: C++ Compiler
# ============================================================================
section "C++ Compiler"

# Check for clang++
if command -v clang++ &> /dev/null; then
    CLANG_VERSION=$(clang++ --version 2>&1 | head -1)
    check_pass "clang++ found"
    verbose "$CLANG_VERSION"

    # Check if it's the Bloomberg reflection fork
    if clang++ --version 2>&1 | grep -qi "reflection\|p2996\|bloomberg"; then
        check_pass "Reflection-enabled clang detected"
    else
        check_warn "Standard clang detected (may not support reflection)" \
            "Mirror Bridge requires Bloomberg's clang-p2996 fork"
    fi
else
    check_fail "clang++ not found" \
        "Install Bloomberg's clang-p2996 or run inside Docker container"
fi

# Check for g++ (alternative)
if command -v g++ &> /dev/null; then
    GCC_VERSION=$(g++ --version 2>&1 | head -1)
    verbose "g++ also available: $GCC_VERSION"
fi

# Test reflection support
section "Reflection Support"

REFLECTION_TEST=$(mktemp /tmp/mirror_bridge_test.XXXXXX.cpp)
cat > "$REFLECTION_TEST" << 'TESTCODE'
#include <meta>
struct Test { int x; };
constexpr auto test_reflection() {
    // Simple test: check that we can use ^^ operator and get type name
    return std::meta::identifier_of(^^Test);
}
int main() {
    constexpr auto name = test_reflection();
    return 0;
}
TESTCODE

REFLECTION_OUTPUT=$(mktemp /tmp/mirror_bridge_test_out.XXXXXX)
if clang++ -std=c++2c -freflection -freflection-latest -stdlib=libc++ "$REFLECTION_TEST" -o "$REFLECTION_OUTPUT" 2>/dev/null; then
    check_pass "C++26 reflection compiles successfully"
else
    check_fail "Reflection test failed to compile" \
        "Ensure you're using Bloomberg's clang-p2996 with -freflection flag"
    if [ $VERBOSE -eq 1 ]; then
        echo -e "  ${BLUE}Test command: clang++ -std=c++2c -freflection -freflection-latest -stdlib=libc++ test.cpp${NC}"
    fi
fi
rm -f "$REFLECTION_TEST" "$REFLECTION_OUTPUT"

# ============================================================================
# Section 2: Python
# ============================================================================
section "Python Environment"

# Check Python version
if command -v python3 &> /dev/null; then
    PYTHON_VERSION=$(python3 --version 2>&1)
    check_pass "Python 3 found: $PYTHON_VERSION"

    # Check Python config
    if command -v python3-config &> /dev/null; then
        check_pass "python3-config available"

        if [ $VERBOSE -eq 1 ]; then
            PYTHON_INCLUDES=$(python3-config --includes 2>/dev/null || echo "N/A")
            verbose "Includes: $PYTHON_INCLUDES"
        fi
    else
        check_fail "python3-config not found" \
            "Install python3-dev or python3-devel package"
    fi

    # Check for Python.h
    PYTHON_INCLUDE_DIR=$(python3 -c "import sysconfig; print(sysconfig.get_path('include'))" 2>/dev/null)
    if [ -f "$PYTHON_INCLUDE_DIR/Python.h" ]; then
        check_pass "Python.h found"
        verbose "Location: $PYTHON_INCLUDE_DIR/Python.h"
    else
        check_fail "Python.h not found" \
            "Install python3-dev package: apt-get install python3-dev"
    fi
else
    check_fail "Python 3 not found" \
        "Install Python 3.8 or later"
fi

# ============================================================================
# Section 3: Lua (Optional)
# ============================================================================
section "Lua Environment (optional)"

if command -v lua5.4 &> /dev/null; then
    LUA_VERSION=$(lua5.4 -v 2>&1)
    check_pass "Lua 5.4 found: $LUA_VERSION"
elif command -v lua &> /dev/null; then
    LUA_VERSION=$(lua -v 2>&1)
    check_warn "Lua found but may not be 5.4: $LUA_VERSION" \
        "Lua 5.4 recommended for best compatibility"
else
    check_warn "Lua not found" \
        "Install lua5.4 for Lua bindings: apt-get install lua5.4 liblua5.4-dev"
fi

# Check Lua headers
if [ -f "/usr/include/lua5.4/lua.h" ]; then
    check_pass "Lua development headers found"
elif [ -f "/usr/include/lua.h" ]; then
    check_pass "Lua development headers found (generic path)"
else
    check_warn "Lua headers not found" \
        "Install liblua5.4-dev for Lua bindings"
fi

# ============================================================================
# Section 4: Node.js (Optional)
# ============================================================================
section "Node.js Environment (optional)"

if command -v node &> /dev/null; then
    NODE_VERSION=$(node --version 2>&1)
    check_pass "Node.js found: $NODE_VERSION"

    if command -v npm &> /dev/null; then
        NPM_VERSION=$(npm --version 2>&1)
        check_pass "npm found: $NPM_VERSION"
    else
        check_warn "npm not found" \
            "Install npm for JavaScript binding development"
    fi
else
    check_warn "Node.js not found" \
        "Install Node.js for JavaScript bindings"
fi

# Check N-API headers
if [ -f "/usr/include/node/node_api.h" ]; then
    check_pass "Node.js N-API headers found"
elif [ -d "/usr/include/node" ]; then
    check_warn "Node include dir exists but node_api.h not found"
else
    check_warn "Node.js headers not found" \
        "Headers usually come with Node.js installation"
fi

# ============================================================================
# Section 5: Library Paths
# ============================================================================
section "Library Paths"

# Check LD_LIBRARY_PATH for libc++
if [ -n "$LD_LIBRARY_PATH" ]; then
    check_pass "LD_LIBRARY_PATH is set"
    verbose "LD_LIBRARY_PATH=$LD_LIBRARY_PATH"
else
    check_warn "LD_LIBRARY_PATH not set" \
        "May need to set for libc++ if using reflection compiler"
fi

# Check for libc++
LIBCXX_FOUND=0
for libdir in /usr/local/lib /usr/lib /usr/local/lib/x86_64-unknown-linux-gnu /usr/local/lib/aarch64-unknown-linux-gnu; do
    if [ -f "$libdir/libc++.so" ] || [ -f "$libdir/libc++.a" ]; then
        LIBCXX_FOUND=1
        verbose "libc++ found in $libdir"
        break
    fi
done

if [ $LIBCXX_FOUND -eq 1 ]; then
    check_pass "libc++ found"
else
    check_warn "libc++ not found in standard locations" \
        "May be needed for reflection compiler"
fi

# ============================================================================
# Section 6: Mirror Bridge Installation
# ============================================================================
section "Mirror Bridge Installation"

# Find script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Check for main header
if [ -f "$SCRIPT_DIR/mirror_bridge.hpp" ]; then
    check_pass "mirror_bridge.hpp found"
elif [ -f "/usr/local/include/mirror_bridge.hpp" ]; then
    check_pass "mirror_bridge.hpp found (system-wide)"
else
    check_warn "mirror_bridge.hpp not found" \
        "Ensure you're running from the mirror_bridge directory"
fi

# Check for core headers
for header in "core/mirror_bridge_core.hpp" "python/mirror_bridge_python.hpp"; do
    if [ -f "$SCRIPT_DIR/$header" ]; then
        check_pass "$header found"
    else
        check_warn "$header not found"
    fi
done

# Check CLI tools
for tool in "mirror_bridge_auto" "mirror_bridge_build" "mirror_bridge_generate"; do
    if [ -x "$SCRIPT_DIR/$tool" ]; then
        check_pass "$tool is executable"
    elif [ -f "$SCRIPT_DIR/$tool" ]; then
        check_warn "$tool exists but not executable" \
            "Run: chmod +x $SCRIPT_DIR/$tool"
    else
        check_warn "$tool not found"
    fi
done

# Check Python discovery script
if [ -f "$SCRIPT_DIR/scripts/discover_symbols.py" ]; then
    check_pass "discover_symbols.py found"
else
    check_fail "discover_symbols.py not found" \
        "Required for auto-discovery feature"
fi

# ============================================================================
# Section 7: Docker Environment
# ============================================================================
section "Docker Environment"

# Check if running inside Docker
if [ -f "/.dockerenv" ]; then
    check_pass "Running inside Docker container"

    # Check container image
    if [ -f "/etc/os-release" ]; then
        . /etc/os-release
        verbose "Container OS: $PRETTY_NAME"
    fi
else
    check_warn "Not running inside Docker" \
        "Docker recommended for consistent reflection compiler setup"

    # Check if Docker is available
    if command -v docker &> /dev/null; then
        check_pass "Docker is available on host"
        verbose "Use: ./start_dev_container.sh to enter development environment"
    else
        check_warn "Docker not installed" \
            "Install Docker for easiest setup experience"
    fi
fi

# ============================================================================
# Section 8: Quick Test
# ============================================================================
section "Quick Functionality Test"

# Try to compile a minimal binding
QUICK_TEST_DIR=$(mktemp -d /tmp/mirror_bridge_quick_test.XXXXXX)
cat > "$QUICK_TEST_DIR/test_class.hpp" << 'TESTCLASS'
struct QuickTest {
    int value = 42;
    int get_value() const { return value; }
};
TESTCLASS

cat > "$QUICK_TEST_DIR/test_binding.cpp" << 'TESTBINDING'
#include "mirror_bridge.hpp"
#include "test_class.hpp"

MIRROR_BRIDGE_MODULE(quick_test,
    mirror_bridge::bind_class<QuickTest>(m, "QuickTest");
)
TESTBINDING

if [ -f "$SCRIPT_DIR/mirror_bridge.hpp" ]; then
    COMPILE_CMD="clang++ -std=c++2c -freflection -freflection-latest -stdlib=libc++ -fPIC -shared"
    COMPILE_CMD="$COMPILE_CMD -I$SCRIPT_DIR -I$QUICK_TEST_DIR"
    COMPILE_CMD="$COMPILE_CMD $(python3-config --includes 2>/dev/null)"
    COMPILE_CMD="$COMPILE_CMD $QUICK_TEST_DIR/test_binding.cpp"
    COMPILE_CMD="$COMPILE_CMD -o $QUICK_TEST_DIR/quick_test.so"
    COMPILE_CMD="$COMPILE_CMD $(python3-config --ldflags 2>/dev/null)"

    if eval "$COMPILE_CMD" 2>/dev/null; then
        check_pass "Quick test compilation succeeded"

        # Try to import in Python
        IMPORT_TEST=$(python3 -c "import sys; sys.path.insert(0, '$QUICK_TEST_DIR'); import quick_test; t = quick_test.QuickTest(); print(t.get_value())" 2>&1)
        if [ "$IMPORT_TEST" = "42" ]; then
            check_pass "Quick test import and execution succeeded"
        else
            check_warn "Quick test import failed" \
                "Compilation works but Python import has issues"
            verbose "Output: $IMPORT_TEST"
        fi
    else
        check_warn "Quick test compilation failed" \
            "Basic setup may have issues - check compiler and headers"
    fi
else
    check_warn "Skipped quick test (mirror_bridge.hpp not found)"
fi

rm -rf "$QUICK_TEST_DIR"

# ============================================================================
# Summary
# ============================================================================
if [ $JSON_MODE -eq 1 ]; then
    STATUS="ok"
    [ $CHECKS_FAILED -gt 0 ] && STATUS="error"
    printf '{"status":"%s","passed":%d,"warnings":%d,"failed":%d,"checks":[%s]}\n' \
        "$STATUS" "$CHECKS_PASSED" "$CHECKS_WARNED" "$CHECKS_FAILED" "${CHECKS_JSON%,}" >&3
    [ $CHECKS_FAILED -eq 0 ] && exit 0 || exit 1
fi

echo ""
echo -e "${BOLD}${BLUE}=======================================${NC}"
echo -e "${BOLD}${BLUE}  Summary${NC}"
echo -e "${BOLD}${BLUE}=======================================${NC}"
echo ""
echo -e "  ${GREEN}Passed:${NC}  $CHECKS_PASSED"
echo -e "  ${YELLOW}Warnings:${NC} $CHECKS_WARNED"
echo -e "  ${RED}Failed:${NC}  $CHECKS_FAILED"
echo ""

if [ $CHECKS_FAILED -eq 0 ]; then
    if [ $CHECKS_WARNED -eq 0 ]; then
        echo -e "${GREEN}${BOLD}All checks passed! Mirror Bridge is ready to use.${NC}"
    else
        echo -e "${YELLOW}${BOLD}Setup looks good with minor warnings.${NC}"
        echo -e "${BLUE}Mirror Bridge should work, but check warnings for optional features.${NC}"
    fi
    exit 0
else
    echo -e "${RED}${BOLD}Some checks failed. Please address the issues above.${NC}"
    echo ""
    echo -e "${BLUE}Common fixes:${NC}"
    echo -e "  1. Run inside Docker: ${YELLOW}./start_dev_container.sh${NC}"
    echo -e "  2. Install Python dev: ${YELLOW}apt-get install python3-dev${NC}"
    echo -e "  3. Check compiler: ${YELLOW}clang++ --version${NC}"
    echo ""
    exit 1
fi
