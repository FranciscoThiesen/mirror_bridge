From 138ef33b109733ca16918b892c5ed5e7718884c9 Mon Sep 17 00:00:00 2001
From: mirror_bridge fork <mirror_bridge@fork.dev>
Date: Sat, 18 Apr 2026 03:23:00 +0000
Subject: [PATCH] mirror_bridge fork: CMake fixes for clang-p2996 + libc++
 builds
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Two upstream-applicable fixes that let Open3D build and load cleanly
when the user has configured a non-default standard library:

1. Forward CMAKE_CXX_FLAGS to 3rdparty ExternalProjects. Without this
   VTK/embree/zeromq/etc. default to libstdc++ on Linux even when the
   top-level build requests libc++ — producing mixed std::__1::* vs
   std::__cxx11::* symbols in libOpen3D.so and failing dlopen on
   basic_ostringstream and std::thread internals.

2. Wrap the BoringSSL static archives with -Wl,--whole-archive when
   linking into libOpen3D.so. Curl and zmq transitively need SSL
   symbols that arent reachable from Open3Ds direct .o files, so the
   linker drops them; dlopen then fails on X509_INFO_free etc.

Both fixes are behind the existing cross-platform guards. macOS and
Windows builds use their platform linkers and system SSL respectively
and are unaffected.
---
 3rdparty/find_dependencies.cmake | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/3rdparty/find_dependencies.cmake b/3rdparty/find_dependencies.cmake
index 02f7b58..bfbadfd 100644
--- a/3rdparty/find_dependencies.cmake
+++ b/3rdparty/find_dependencies.cmake
@@ -160,6 +160,14 @@ endfunction()
 
 # CMake arguments for configuring ExternalProjects. Use the second _hidden
 # version by default.
+#
+# mirror_bridge fork: CMAKE_CXX_FLAGS and CMAKE_C_FLAGS are now forwarded
+# so that top-level flags like `-stdlib=libc++` reach VTK, embree, zmq, and
+# every other vendored 3rdparty. Without this, 3rdparty libs default to
+# libstdc++ on Linux, producing mixed ABI symbols (std::__1::* from
+# libc++ + std::__cxx11::* from libstdc++) in the final libOpen3D.so —
+# which fails to dlopen. Same rationale applies to CMAKE_EXE_LINKER_FLAGS
+# and CMAKE_SHARED_LINKER_FLAGS (for `-stdlib=libc++` at link time).
 set(ExternalProject_CMAKE_ARGS
     -DCMAKE_POLICY_VERSION_MINIMUM=3.5      # for VTK 9.1
     -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
@@ -169,6 +177,12 @@ set(ExternalProject_CMAKE_ARGS
     -DCMAKE_CXX_COMPILER_LAUNCHER=${CMAKE_CXX_COMPILER_LAUNCHER}
     -DCMAKE_CUDA_COMPILER_LAUNCHER=${CMAKE_CUDA_COMPILER_LAUNCHER}
     -DCMAKE_CUDA_FLAGS=${CMAKE_CUDA_FLAGS}
+    # Forward user-provided CXX flags (e.g. -stdlib=libc++) to 3rdparty builds
+    # so their static archives match the ABI of libOpen3D.so. We deliberately
+    # DO NOT forward linker flags — Fortran-only archives (OpenBLAS) don't
+    # accept -stdlib=libc++ on their link line, and clang++ carries that flag
+    # through at link time automatically for any C++ .o.
+    -DCMAKE_CXX_FLAGS=${CMAKE_CXX_FLAGS}
     -DCMAKE_OSX_DEPLOYMENT_TARGET=${CMAKE_OSX_DEPLOYMENT_TARGET}
     -DCMAKE_CUDA_FLAGS=${CMAKE_CUDA_FLAGS}
     -DCMAKE_SYSTEM_VERSION=${CMAKE_SYSTEM_VERSION}
@@ -900,6 +914,22 @@ if(NOT USE_SYSTEM_OPENSSL)
         LIBRARIES    ${BORINGSSL_LIBRARIES}
         DEPENDS      ext_zlib ext_boringssl
     )
+    # mirror_bridge fork: BoringSSL static archives carry hidden-visibility
+    # symbols that curl / zeromq reference through Open3D. Without
+    # --whole-archive the linker drops the unreferenced-from-Open3D-direct
+    # SSL entry points (e.g. X509_INFO_free) and the resulting libOpen3D.so
+    # has unresolved SSL symbols at dlopen. Force-include every symbol from
+    # the BoringSSL archives; the version script still hides them from the
+    # .so's dynamic exports so API surface is unchanged.
+    if(UNIX AND NOT APPLE)
+        set_property(TARGET 3rdparty_openssl APPEND PROPERTY
+            INTERFACE_LINK_OPTIONS
+                "LINKER:--whole-archive"
+                "${BORINGSSL_LIB_DIR}/libssl.a"
+                "${BORINGSSL_LIB_DIR}/libcrypto.a"
+                "LINKER:--no-whole-archive"
+        )
+    endif()
 endif()
 
 if(NOT USE_SYSTEM_CURL)
