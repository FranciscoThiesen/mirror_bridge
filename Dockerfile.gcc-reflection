# Stock GCC 16 (C++26 reflection shipped in 16.1) plus everything the test
# suite needs. The official image is Debian-based with GCC in /usr/local.
FROM gcc:16

ENV DEBIAN_FRONTEND=noninteractive

# C++ deps mirror the clang image so downstream binding targets (e.g. the
# Eigen-based inheritance example) build identically under GCC.
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    ninja-build \
    git \
    python3 \
    python3-dev \
    python3-numpy \
    python3-pip \
    nodejs \
    npm \
    lua5.4 \
    liblua5.4-dev \
    ca-certificates \
    libeigen3-dev \
    libfmt-dev \
    libjsoncpp-dev \
    libnanoflann-dev \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g node-gyp node-addon-api

ENV CC=/usr/local/bin/gcc
ENV CXX=/usr/local/bin/g++

# GCC spells reflection -std=c++26 -freflection (clang-p2996: -std=c++2c -freflection)
RUN echo '#include <meta>' > /tmp/test.cpp && \
    echo 'int main() { return 0; }' >> /tmp/test.cpp && \
    g++ -std=c++26 -freflection /tmp/test.cpp -o /tmp/test && \
    rm /tmp/test.cpp /tmp/test && \
    echo "SUCCESS: GCC reflection support verified"

WORKDIR /workspace

CMD ["/bin/bash"]
