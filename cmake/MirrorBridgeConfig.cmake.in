# MirrorBridgeConfig.cmake
# ========================
#
# Mirror Bridge CMake configuration file for find_package()
#
# This file is configured by CMake to be installed with Mirror Bridge,
# enabling users to easily find and use the library.
#
# Usage:
#   find_package(MirrorBridge REQUIRED)
#
#   # Create a Python module
#   mirror_bridge_add_module(mymodule
#       SOURCES myclass.cpp
#       HEADERS myclass.hpp
#       LANGUAGES Python Lua JavaScript
#   )
#
# Imported Targets:
#   MirrorBridge::MirrorBridge - Header-only interface library
#
# Variables:
#   MirrorBridge_FOUND       - True if found
#   MirrorBridge_VERSION     - Version string
#   MirrorBridge_INCLUDE_DIR - Include directory

@PACKAGE_INIT@

set(MirrorBridge_VERSION "@PROJECT_VERSION@")

# Include directory
set_and_check(MirrorBridge_INCLUDE_DIR "@PACKAGE_INCLUDE_INSTALL_DIR@")

# Import targets
include("${CMAKE_CURRENT_LIST_DIR}/MirrorBridgeTargets.cmake")

# Compiler requirements check
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    message(WARNING
        "Mirror Bridge requires clang-p2996 with C++26 reflection support.\n"
        "Current compiler: ${CMAKE_CXX_COMPILER_ID}\n"
        "Please use: cmake -DCMAKE_CXX_COMPILER=/path/to/clang++"
    )
endif()

# Required compile flags for reflection
set(MIRROR_BRIDGE_COMPILE_FLAGS
    -std=c++2c
    -freflection
    -freflection-latest
    -stdlib=libc++
)

set(MIRROR_BRIDGE_LINK_FLAGS
    -stdlib=libc++
)

# ============================================================================
# Helper Functions
# ============================================================================

# Find Python if needed
function(_mirror_bridge_find_python)
    if(NOT Python3_FOUND)
        find_package(Python3 COMPONENTS Interpreter Development REQUIRED)
    endif()
endfunction()

# Find Lua if needed
function(_mirror_bridge_find_lua)
    if(NOT LUA_FOUND)
        find_package(PkgConfig QUIET)
        if(PkgConfig_FOUND)
            pkg_check_modules(LUA QUIET lua5.4)
            if(NOT LUA_FOUND)
                pkg_check_modules(LUA QUIET lua)
            endif()
        endif()

        if(NOT LUA_FOUND)
            find_path(LUA_INCLUDE_DIR lua.h
                PATHS /usr/include/lua5.4 /usr/include/lua /usr/local/include
            )
            find_library(LUA_LIBRARY NAMES lua5.4 lua
                PATHS /usr/lib /usr/local/lib
            )
            if(LUA_INCLUDE_DIR AND LUA_LIBRARY)
                set(LUA_FOUND TRUE PARENT_SCOPE)
                set(LUA_INCLUDE_DIRS ${LUA_INCLUDE_DIR} PARENT_SCOPE)
                set(LUA_LIBRARIES ${LUA_LIBRARY} PARENT_SCOPE)
            endif()
        endif()
    endif()
endfunction()

# Find Node.js N-API if needed
function(_mirror_bridge_find_nodejs)
    if(NOT NAPI_FOUND)
        find_path(NAPI_INCLUDE_DIR node_api.h
            PATHS /usr/include/node /usr/local/include/node
        )
        if(NAPI_INCLUDE_DIR)
            set(NAPI_FOUND TRUE PARENT_SCOPE)
            set(NAPI_INCLUDE_DIRS ${NAPI_INCLUDE_DIR} PARENT_SCOPE)
        endif()
    endif()
endfunction()

# ============================================================================
# Main Function: mirror_bridge_add_module
# ============================================================================
#
# Creates binding modules for one or more languages from a single source.
#
# Usage:
#   mirror_bridge_add_module(mymodule
#       SOURCES myclass_binding.cpp
#       HEADERS myclass.hpp
#       LANGUAGES Python Lua JavaScript  # One or more
#       INCLUDE_DIRS ${CMAKE_CURRENT_SOURCE_DIR}/include
#   )
#
# This creates targets:
#   - mymodule_python (if Python in LANGUAGES)
#   - mymodule_lua (if Lua in LANGUAGES)
#   - mymodule_js (if JavaScript in LANGUAGES)
#
function(mirror_bridge_add_module TARGET_BASE)
    cmake_parse_arguments(ARG
        ""
        ""
        "SOURCES;HEADERS;LANGUAGES;INCLUDE_DIRS"
        ${ARGN}
    )

    # Default to all languages if not specified
    if(NOT ARG_LANGUAGES)
        set(ARG_LANGUAGES Python Lua JavaScript)
    endif()

    # Process each language
    foreach(LANG ${ARG_LANGUAGES})
        string(TOLOWER ${LANG} LANG_LOWER)

        if(LANG STREQUAL "Python")
            _mirror_bridge_find_python()
            if(Python3_FOUND)
                set(TARGET_NAME ${TARGET_BASE})

                Python3_add_library(${TARGET_NAME} MODULE ${ARG_SOURCES})

                target_compile_options(${TARGET_NAME} PRIVATE ${MIRROR_BRIDGE_COMPILE_FLAGS})
                target_link_options(${TARGET_NAME} PRIVATE ${MIRROR_BRIDGE_LINK_FLAGS})
                target_link_libraries(${TARGET_NAME} PRIVATE MirrorBridge::MirrorBridge)
                target_include_directories(${TARGET_NAME} PRIVATE
                    ${MirrorBridge_INCLUDE_DIR}
                    ${ARG_INCLUDE_DIRS}
                )

                set_target_properties(${TARGET_NAME} PROPERTIES
                    PREFIX ""
                    OUTPUT_NAME ${TARGET_BASE}
                )

                message(STATUS "  Created Python module: ${TARGET_NAME}")
            else()
                message(WARNING "Python not found - skipping Python binding for ${TARGET_BASE}")
            endif()

        elseif(LANG STREQUAL "Lua")
            _mirror_bridge_find_lua()
            if(LUA_FOUND)
                set(TARGET_NAME ${TARGET_BASE}_lua)

                add_library(${TARGET_NAME} MODULE ${ARG_SOURCES})

                target_compile_options(${TARGET_NAME} PRIVATE ${MIRROR_BRIDGE_COMPILE_FLAGS})
                target_link_options(${TARGET_NAME} PRIVATE ${MIRROR_BRIDGE_LINK_FLAGS})
                target_link_libraries(${TARGET_NAME} PRIVATE
                    MirrorBridge::MirrorBridge
                    ${LUA_LIBRARIES}
                )
                target_include_directories(${TARGET_NAME} PRIVATE
                    ${MirrorBridge_INCLUDE_DIR}
                    ${LUA_INCLUDE_DIRS}
                    ${ARG_INCLUDE_DIRS}
                )

                set_target_properties(${TARGET_NAME} PROPERTIES
                    PREFIX ""
                    SUFFIX ".so"
                    OUTPUT_NAME ${TARGET_BASE}_lua
                )

                message(STATUS "  Created Lua module: ${TARGET_NAME}")
            else()
                message(WARNING "Lua not found - skipping Lua binding for ${TARGET_BASE}")
            endif()

        elseif(LANG STREQUAL "JavaScript" OR LANG STREQUAL "JS")
            _mirror_bridge_find_nodejs()
            if(NAPI_FOUND)
                set(TARGET_NAME ${TARGET_BASE}_js)

                add_library(${TARGET_NAME} MODULE ${ARG_SOURCES})

                target_compile_options(${TARGET_NAME} PRIVATE ${MIRROR_BRIDGE_COMPILE_FLAGS})
                target_link_options(${TARGET_NAME} PRIVATE ${MIRROR_BRIDGE_LINK_FLAGS})
                target_link_libraries(${TARGET_NAME} PRIVATE MirrorBridge::MirrorBridge)
                target_include_directories(${TARGET_NAME} PRIVATE
                    ${MirrorBridge_INCLUDE_DIR}
                    ${NAPI_INCLUDE_DIRS}
                    ${ARG_INCLUDE_DIRS}
                )

                set_target_properties(${TARGET_NAME} PROPERTIES
                    PREFIX ""
                    SUFFIX ".node"
                    OUTPUT_NAME ${TARGET_BASE}
                )

                message(STATUS "  Created JavaScript module: ${TARGET_NAME}")
            else()
                message(WARNING "Node.js N-API not found - skipping JavaScript binding for ${TARGET_BASE}")
            endif()

        else()
            message(WARNING "Unknown language: ${LANG}")
        endif()
    endforeach()
endfunction()

# Provide check_required_components
check_required_components(MirrorBridge)
