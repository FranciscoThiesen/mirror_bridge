#!/bin/bash
# Mirror Bridge - Unified CLI Tool
# Generates C++ bindings for Python, Lua, and JavaScript using C++26 reflection
#
# Usage: mirror_bridge <command> [options]
#
# Commands:
#   generate    Auto-discover and compile bindings from C++ headers
#   pch         Build precompiled header for faster compilation
#   build       Compile a manually-written binding file
#   config      Generate bindings from a configuration file
#   init        Initialize a new Mirror Bridge project
#   version     Show version information

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Version
VERSION="0.2.0"

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Default configuration
OUTPUT_DIR="build"
VERBOSE=0
KEEP_GENERATED=0
FORCE_REBUILD=0
USE_PCH=""
PCH_PATH=""
LANG="python"

# Show main help
show_help() {
    cat << EOF
${CYAN}Mirror Bridge${NC} - C++ to Multi-Language Bindings via Reflection

${YELLOW}Usage:${NC}
  mirror_bridge <command> [options]

${YELLOW}Commands:${NC}
  generate    Auto-discover and compile bindings from C++ headers
  pch         Build precompiled header for faster compilation
  build       Compile a manually-written binding file
  config      Generate bindings from a configuration file
  diff        Show binding surface changes since last build
  init        Initialize a new Mirror Bridge project
  version     Show version information

${YELLOW}Examples:${NC}
  mirror_bridge generate src/ --module my_module --lang python
  mirror_bridge generate src/ --module my_module --lang all --pch
  mirror_bridge pch --output build/ --type release
  mirror_bridge config my_module.mirror

${YELLOW}Documentation:${NC}
  https://github.com/FranciscoThiesen/mirror_bridge/docs

Run 'mirror_bridge <command> --help' for command-specific help.
EOF
}

# Show generate help
show_generate_help() {
    cat << EOF
${CYAN}mirror_bridge generate${NC} - Auto-discover and compile bindings

${YELLOW}Usage:${NC}
  mirror_bridge generate <src_dir> --module <name> --lang <language> [options]

${YELLOW}Required:${NC}
  <src_dir>           Directory containing C++ headers
  --module NAME       Output module name
  --lang LANG         Target language: python, lua, js, or all

${YELLOW}Options:${NC}
  -o, --output DIR    Output directory (default: build/)
  -k, --keep-generated Keep generated binding .cpp file
  -v, --verbose       Show compilation output
  --pch [PATH]        Use precompiled header (auto-detect or specify path)
  -f, --force         Force rebuild even if sources haven't changed
  -I DIR              Add include directory
  -h, --help          Show this help

${YELLOW}Auto-Discovery:${NC}
  Scans all .hpp/.h files in src_dir and automatically binds all
  struct/class definitions found.

  Opt-out: Add comment "MIRROR_BRIDGE_SKIP" before class to skip it.

${YELLOW}Examples:${NC}
  # Python bindings
  mirror_bridge generate src/ --module my_module --lang python

  # All languages at once
  mirror_bridge generate src/ --module my_module --lang all

  # With precompiled header (3-6x faster!)
  mirror_bridge generate src/ --module my_module --lang python --pch

  # Force rebuild
  mirror_bridge generate src/ --module my_module --lang python -f
EOF
}

# Show pch help
show_pch_help() {
    cat << EOF
${CYAN}mirror_bridge pch${NC} - Build precompiled header

${YELLOW}Usage:${NC}
  mirror_bridge pch --output <dir> --type <type> [options]

${YELLOW}Required:${NC}
  --output DIR        Output directory for PCH file
  --type TYPE         Build type: release or debug

${YELLOW}Options:${NC}
  --lang LANG         Target language (default: python)
  -v, --verbose       Show compilation output
  -h, --help          Show this help

${YELLOW}Examples:${NC}
  # Release PCH for Python
  mirror_bridge pch --output build/ --type release

  # Debug PCH
  mirror_bridge pch --output build/ --type debug

${YELLOW}Performance:${NC}
  Without PCH: ~500-1700ms compilation
  With PCH:    ~200-250ms compilation (3-6x faster!)
EOF
}

# Discover classes in source directory
discover_classes() {
    local src_dir="$1"
    local -n classes_ref=$2
    local -n headers_ref=$3

    local header_files
    header_files=$(find "$src_dir" -type f \( -name "*.hpp" -o -name "*.h" \) | sort)

    if [ -z "$header_files" ]; then
        echo -e "${RED}Error: No header files found in $src_dir${NC}"
        exit 1
    fi

    while IFS= read -r header_file; do
        local rel_path
        rel_path=$(realpath --relative-to="$src_dir" "$header_file")

        # Skip files marked with MIRROR_BRIDGE_SKIP_FILE
        if grep -q "MIRROR_BRIDGE_SKIP_FILE" "$header_file" 2>/dev/null; then
            [ $VERBOSE -eq 1 ] && echo -e "${BLUE}  Skipping file: $rel_path${NC}"
            continue
        fi

        # Find class/struct definitions
        while IFS= read -r line; do
            if [[ "$line" =~ ^[[:space:]]*(struct|class)[[:space:]]+([a-zA-Z_][a-zA-Z0-9_]*) ]]; then
                local class_name="${BASH_REMATCH[2]}"

                # Skip forward declarations
                [[ "$line" =~ \;[[:space:]]*$ ]] && continue

                # Check for MIRROR_BRIDGE_SKIP
                local line_num
                line_num=$(grep -n "^[[:space:]]*\(struct\|class\)[[:space:]]\+$class_name" "$header_file" | head -1 | cut -d: -f1)
                if [ -n "$line_num" ] && [ "$line_num" -gt 1 ]; then
                    local prev_line=$((line_num - 1))
                    if sed -n "${prev_line}p" "$header_file" | grep -q "MIRROR_BRIDGE_SKIP"; then
                        [ $VERBOSE -eq 1 ] && echo -e "${BLUE}  Skipping: $class_name (marked SKIP)${NC}"
                        continue
                    fi
                fi

                classes_ref+=("$class_name")
                headers_ref+=("$rel_path")
                echo -e "  ${GREEN}✓${NC} Found: $class_name in $rel_path"
            fi
        done < "$header_file"
    done <<< "$header_files"
}

# Generate binding file for a specific language
generate_binding_file() {
    local lang="$1"
    local module_name="$2"
    local output_file="$3"
    local -n classes=$4
    local -n headers=$5
    local src_dir="$6"

    local include_header
    local module_macro
    local bind_func

    case "$lang" in
        python)
            include_header="mirror_bridge.hpp"
            module_macro="MIRROR_BRIDGE_MODULE"
            bind_func="mirror_bridge::bind_class"
            ;;
        lua)
            include_header="lua/mirror_bridge_lua.hpp"
            module_macro="MIRROR_BRIDGE_LUA_MODULE"
            bind_func="mirror_bridge::lua::bind_class"
            ;;
        js|javascript)
            include_header="javascript/mirror_bridge_javascript.hpp"
            module_macro="MIRROR_BRIDGE_JS_MODULE"
            bind_func="mirror_bridge::javascript::bind_class"
            ;;
    esac

    cat > "$output_file" << EOF
// Auto-generated by mirror_bridge
// Source: $src_dir
// Language: $lang
// Generated: $(date)

#include "$include_header"
EOF

    # Add unique header includes
    declare -A included
    for header in "${headers[@]}"; do
        if [ -z "${included[$header]}" ]; then
            echo "#include \"$header\"" >> "$output_file"
            included[$header]=1
        fi
    done

    echo "" >> "$output_file"

    # Generate module
    if [ "$lang" = "js" ] || [ "$lang" = "javascript" ]; then
        echo "$module_macro($module_name," >> "$output_file"
        for class_name in "${classes[@]}"; do
            echo "    $bind_func<$class_name>(env, m, \"$class_name\");" >> "$output_file"
        done
    else
        echo "$module_macro($module_name," >> "$output_file"
        for class_name in "${classes[@]}"; do
            if [ "$lang" = "lua" ]; then
                echo "    $bind_func<$class_name>(L, \"$class_name\");" >> "$output_file"
            else
                echo "    $bind_func<$class_name>(m, \"$class_name\");" >> "$output_file"
            fi
        done
    fi

    echo ")" >> "$output_file"
}

# Compile binding for a specific language
compile_binding() {
    local lang="$1"
    local module_name="$2"
    local binding_file="$3"
    local output_dir="$4"
    local src_dir="$5"
    local pch_path="$6"

    local output_ext
    local compile_flags
    local link_flags=""

    case "$lang" in
        python)
            output_ext=".so"
            compile_flags="$(python3-config --includes)"
            link_flags="$(python3-config --ldflags 2>/dev/null || echo "")"
            ;;
        lua)
            output_ext=".so"
            compile_flags="-I/usr/include/lua5.4"
            link_flags="-llua5.4"
            ;;
        js|javascript)
            output_ext=".node"
            compile_flags="-I/usr/include/node"
            ;;
    esac

    local output_file="$output_dir/${module_name}${output_ext}"

    local cmd="clang++ -std=c++2c -freflection -freflection-latest -stdlib=libc++ \
        -I. -I$src_dir -I$PROJECT_ROOT \
        -fPIC -shared -O3 -DNDEBUG"

    if [ -n "$pch_path" ] && [ -f "$pch_path" ]; then
        cmd="$cmd -include-pch $pch_path"
    fi

    cmd="$cmd $compile_flags $binding_file -o $output_file $link_flags"

    if [ $VERBOSE -eq 1 ]; then
        echo -e "${BLUE}$cmd${NC}"
        eval "$cmd"
    else
        eval "$cmd" 2>&1 | grep -E "(error|Error)" || true
    fi

    if [ -f "$output_file" ]; then
        echo -e "${GREEN}✓ Built: $output_file${NC}"
        return 0
    else
        echo -e "${RED}✗ Failed to build: $output_file${NC}"
        return 1
    fi
}

# Command: generate
cmd_generate() {
    local src_dir=""
    local module_name=""
    local include_dirs=()

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help) show_generate_help; exit 0 ;;
            --module) module_name="$2"; shift 2 ;;
            --lang) LANG="$2"; shift 2 ;;
            -o|--output) OUTPUT_DIR="$2"; shift 2 ;;
            -k|--keep-generated) KEEP_GENERATED=1; shift ;;
            -v|--verbose) VERBOSE=1; shift ;;
            -f|--force) FORCE_REBUILD=1; shift ;;
            -I) include_dirs+=("$2"); shift 2 ;;
            --pch)
                USE_PCH="1"
                if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
                    PCH_PATH="$2"; shift 2
                else
                    PCH_PATH="auto"; shift
                fi
                ;;
            -*)
                echo -e "${RED}Error: Unknown option $1${NC}"
                show_generate_help
                exit 1
                ;;
            *)
                if [ -z "$src_dir" ]; then
                    src_dir="$1"
                fi
                shift
                ;;
        esac
    done

    # Validate
    [ -z "$src_dir" ] && { echo -e "${RED}Error: No source directory specified${NC}"; show_generate_help; exit 1; }
    [ -z "$module_name" ] && { echo -e "${RED}Error: No module name specified (use --module)${NC}"; show_generate_help; exit 1; }
    [ ! -d "$src_dir" ] && { echo -e "${RED}Error: Directory not found: $src_dir${NC}"; exit 1; }

    src_dir=$(realpath "$src_dir")
    OUTPUT_DIR=$(realpath "$OUTPUT_DIR" 2>/dev/null || echo "$OUTPUT_DIR")
    mkdir -p "$OUTPUT_DIR"

    echo -e "${CYAN}Mirror Bridge - Generate Bindings${NC}"
    echo -e "${CYAN}==================================${NC}"
    echo ""
    echo -e "Source:  ${YELLOW}$src_dir${NC}"
    echo -e "Module:  ${YELLOW}$module_name${NC}"
    echo -e "Lang:    ${YELLOW}$LANG${NC}"
    echo ""

    # Discover classes
    echo -e "${YELLOW}Scanning for classes...${NC}"
    declare -a CLASSES
    declare -a HEADERS
    discover_classes "$src_dir" CLASSES HEADERS

    if [ ${#CLASSES[@]} -eq 0 ]; then
        echo -e "${RED}Error: No classes found in $src_dir${NC}"
        exit 1
    fi

    echo ""
    echo -e "${GREEN}Discovered ${#CLASSES[@]} classes${NC}"
    echo ""

    # Auto-detect PCH if requested
    if [ "$PCH_PATH" = "auto" ]; then
        for pch_candidate in \
            "$OUTPUT_DIR/mirror_bridge_pch.hpp.gch" \
            "build/mirror_bridge_pch.hpp.gch" \
            "mirror_bridge_pch.hpp.gch"
        do
            if [ -f "$pch_candidate" ]; then
                PCH_PATH="$pch_candidate"
                echo -e "${GREEN}✓ Found PCH: $PCH_PATH${NC}"
                break
            fi
        done

        if [ "$PCH_PATH" = "auto" ]; then
            echo -e "${YELLOW}Note: No PCH found. Consider running 'mirror_bridge pch' for faster builds.${NC}"
            PCH_PATH=""
        fi
    fi

    # Determine languages to generate
    local languages=()
    case "$LANG" in
        all) languages=("python" "lua" "js") ;;
        python|lua|js|javascript) languages=("$LANG") ;;
        *) echo -e "${RED}Error: Unknown language: $LANG${NC}"; exit 1 ;;
    esac

    # Generate and compile for each language
    for lang in "${languages[@]}"; do
        echo -e "${YELLOW}Generating $lang bindings...${NC}"

        local binding_file="$OUTPUT_DIR/${module_name}_${lang}_binding.cpp"
        generate_binding_file "$lang" "$module_name" "$binding_file" CLASSES HEADERS "$src_dir"

        echo -e "${YELLOW}Compiling $lang module...${NC}"
        compile_binding "$lang" "$module_name" "$binding_file" "$OUTPUT_DIR" "$src_dir" "$PCH_PATH"

        if [ $KEEP_GENERATED -eq 0 ]; then
            rm -f "$binding_file"
        fi
    done

    echo ""
    echo -e "${GREEN}✓ Successfully built bindings for: ${languages[*]}${NC}"
}

# Command: pch
cmd_pch() {
    local output_dir=""
    local build_type=""
    local pch_lang="python"

    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help) show_pch_help; exit 0 ;;
            --output) output_dir="$2"; shift 2 ;;
            --type) build_type="$2"; shift 2 ;;
            --lang) pch_lang="$2"; shift 2 ;;
            -v|--verbose) VERBOSE=1; shift ;;
            *)
                echo -e "${RED}Error: Unknown option $1${NC}"
                show_pch_help
                exit 1
                ;;
        esac
    done

    [ -z "$output_dir" ] && { echo -e "${RED}Error: --output required${NC}"; show_pch_help; exit 1; }
    [ -z "$build_type" ] && { echo -e "${RED}Error: --type required (release or debug)${NC}"; show_pch_help; exit 1; }

    mkdir -p "$output_dir"

    local opt_flags
    case "$build_type" in
        release) opt_flags="-O3 -DNDEBUG" ;;
        debug) opt_flags="-O0 -g" ;;
        *) echo -e "${RED}Error: Unknown build type: $build_type${NC}"; exit 1 ;;
    esac

    local pch_file="$PROJECT_ROOT/mirror_bridge_pch.hpp"
    local output_file="$output_dir/mirror_bridge_pch.hpp.gch"

    echo -e "${CYAN}Building Precompiled Header${NC}"
    echo -e "Type: ${YELLOW}$build_type${NC}"
    echo -e "Output: ${YELLOW}$output_file${NC}"
    echo ""

    local cmd="clang++ -std=c++2c -freflection -freflection-latest \
        -fPIC -stdlib=libc++ \
        $(python3-config --includes) \
        $opt_flags \
        -x c++-header $pch_file \
        -o $output_file"

    if [ $VERBOSE -eq 1 ]; then
        echo -e "${BLUE}$cmd${NC}"
    fi

    echo -e "${YELLOW}Compiling PCH (this takes ~600ms)...${NC}"
    eval "$cmd" 2>&1 | grep -v "mixture of designated" || true

    if [ -f "$output_file" ]; then
        echo -e "${GREEN}✓ PCH created: $output_file${NC}"
    else
        echo -e "${RED}✗ Failed to create PCH${NC}"
        exit 1
    fi
}

# Command: build
cmd_build() {
    local binding_file=""
    local include_dirs=()

    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                echo "Usage: mirror_bridge build <binding.cpp> [options]"
                exit 0
                ;;
            -o|--output) OUTPUT_DIR="$2"; shift 2 ;;
            -I) include_dirs+=("-I$2"); shift 2 ;;
            -v|--verbose) VERBOSE=1; shift ;;
            --pch)
                if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
                    PCH_PATH="$2"; shift 2
                else
                    PCH_PATH="auto"; shift
                fi
                ;;
            --lang) LANG="$2"; shift 2 ;;
            -*)
                echo -e "${RED}Error: Unknown option $1${NC}"
                exit 1
                ;;
            *)
                binding_file="$1"
                shift
                ;;
        esac
    done

    [ -z "$binding_file" ] && { echo -e "${RED}Error: No binding file specified${NC}"; exit 1; }
    [ ! -f "$binding_file" ] && { echo -e "${RED}Error: File not found: $binding_file${NC}"; exit 1; }

    mkdir -p "$OUTPUT_DIR"

    # Extract module name from filename
    local module_name
    module_name=$(basename "$binding_file" | sed 's/_binding\.cpp$//' | sed 's/\.cpp$//')

    echo -e "${CYAN}Building: $binding_file${NC}"
    compile_binding "$LANG" "$module_name" "$binding_file" "$OUTPUT_DIR" "." "$PCH_PATH"
}

# Command: config
cmd_config() {
    local config_file=""

    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                echo "Usage: mirror_bridge config <config.mirror> [options]"
                exit 0
                ;;
            -o|--output) OUTPUT_DIR="$2"; shift 2 ;;
            -v|--verbose) VERBOSE=1; shift ;;
            -k|--keep-generated) KEEP_GENERATED=1; shift ;;
            --pch)
                if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
                    PCH_PATH="$2"; shift 2
                else
                    PCH_PATH="auto"; shift
                fi
                ;;
            -*)
                echo -e "${RED}Error: Unknown option $1${NC}"
                exit 1
                ;;
            *)
                config_file="$1"
                shift
                ;;
        esac
    done

    [ -z "$config_file" ] && { echo -e "${RED}Error: No config file specified${NC}"; exit 1; }
    [ ! -f "$config_file" ] && { echo -e "${RED}Error: Config file not found: $config_file${NC}"; exit 1; }

    # Use existing mirror_bridge_generate script
    local generate_script="$PROJECT_ROOT/mirror_bridge_generate"
    if [ -x "$generate_script" ]; then
        local args=("$config_file" "-o" "$OUTPUT_DIR")
        [ $VERBOSE -eq 1 ] && args+=("-v")
        [ $KEEP_GENERATED -eq 1 ] && args+=("-k")
        "$generate_script" "${args[@]}"
    else
        echo -e "${RED}Error: Config file generation not available${NC}"
        exit 1
    fi
}

# Command: diff - Show binding surface changes between builds
# Compares current class signatures with the last recorded snapshot
cmd_diff() {
    local src_dir=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --help|-h) show_diff_help; exit 0 ;;
            --output|-o) OUTPUT_DIR="$2"; shift 2 ;;
            *) src_dir="$1"; shift ;;
        esac
    done

    [ -z "$src_dir" ] && { echo -e "${RED}Error: Source directory required${NC}"; exit 1; }

    local snapshot_dir="$OUTPUT_DIR/.mirror_bridge"
    local snapshot_file="$snapshot_dir/binding_snapshot.txt"

    # Scan current headers and extract class signatures
    local current_sig=$(scan_binding_signatures "$src_dir")

    if [ ! -f "$snapshot_file" ]; then
        echo -e "${YELLOW}No previous snapshot found. Creating initial snapshot.${NC}"
        mkdir -p "$snapshot_dir"
        echo "$current_sig" > "$snapshot_file"
        echo -e "${GREEN}Snapshot saved to $snapshot_file${NC}"
        return 0
    fi

    local previous_sig=$(cat "$snapshot_file")

    if [ "$current_sig" = "$previous_sig" ]; then
        echo -e "${GREEN}No binding surface changes detected.${NC}"
        return 0
    fi

    echo -e "${CYAN}Binding Surface Changes:${NC}"
    echo "========================"

    # Compare line by line
    diff --color=auto <(echo "$previous_sig") <(echo "$current_sig") || true

    # Show summary
    local added=$(diff <(echo "$previous_sig") <(echo "$current_sig") | grep "^>" | wc -l)
    local removed=$(diff <(echo "$previous_sig") <(echo "$current_sig") | grep "^<" | wc -l)

    echo ""
    echo -e "  ${GREEN}+ $added added${NC}  ${RED}- $removed removed${NC}"
    echo ""

    # Update snapshot
    read -p "Update snapshot? [y/N] " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo "$current_sig" > "$snapshot_file"
        echo -e "${GREEN}Snapshot updated.${NC}"
    fi
}

# Scan headers to extract binding signatures (class names, members, methods)
scan_binding_signatures() {
    local src_dir="$1"

    # Extract struct/class declarations and their public members
    for header in "$src_dir"/*.hpp "$src_dir"/*.h; do
        [ -f "$header" ] || continue
        local basename=$(basename "$header")

        # Skip files marked with MIRROR_BRIDGE_SKIP
        grep -q "MIRROR_BRIDGE_SKIP" "$header" 2>/dev/null && continue

        echo "=== $basename ==="

        # Extract class/struct names
        grep -E "^(struct|class)\s+\w+" "$header" 2>/dev/null | while read -r line; do
            local class_name=$(echo "$line" | grep -oE "(struct|class)\s+\w+" | awk '{print $2}')
            echo "  class: $class_name"
        done

        # Extract public data members (type name = default pattern)
        grep -E "^\s+(int|double|float|bool|std::\w+|unsigned|long|short|char)\s+\w+" "$header" 2>/dev/null | \
            sed 's/^\s*/  member: /' | head -50

        # Extract method signatures
        grep -E "^\s+\w+.*\w+\(.*\)" "$header" 2>/dev/null | \
            grep -v "^\s*//" | grep -v "^\s*#" | grep -v "^\s*if\b" | grep -v "^\s*for\b" | grep -v "^\s*while\b" | grep -v "^\s*return\b" | \
            sed 's/^\s*/  method: /' | head -50

        echo ""
    done
}

show_diff_help() {
    cat << EOF
${CYAN}mirror_bridge diff${NC} - Show binding surface changes

${YELLOW}Usage:${NC}
  mirror_bridge diff <src_dir> [--output <dir>]

Compares the current class definitions in <src_dir> against a stored
snapshot, showing added/removed members and methods. Useful for catching
accidental ABI breaks during development.

${YELLOW}Options:${NC}
  --output, -o    Build directory for storing snapshots (default: build)

${YELLOW}Example:${NC}
  mirror_bridge diff src/
  mirror_bridge diff src/ --output build/
EOF
}

# Command: version
cmd_version() {
    echo "Mirror Bridge v$VERSION"
    echo "C++26 Reflection-based binding generator"
    echo ""
    echo "Supported languages: Python, Lua, JavaScript"
    echo "Compiler required: Bloomberg clang-p2996"
}

# Main entry point
main() {
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi

    local command="$1"
    shift

    case "$command" in
        generate) cmd_generate "$@" ;;
        pch) cmd_pch "$@" ;;
        build) cmd_build "$@" ;;
        config) cmd_config "$@" ;;
        diff) cmd_diff "$@" ;;
        init) echo "Not yet implemented"; exit 1 ;;
        version|--version|-v) cmd_version ;;
        help|--help|-h) show_help ;;
        *)
            echo -e "${RED}Error: Unknown command '$command'${NC}"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

main "$@"
