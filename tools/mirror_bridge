${YELLOW}Example:${NC}
  mirror_bridge diff src/
  mirror_bridge diff src/ --update      # Non-interactive update
  mirror_bridge diff src/ --check       # CI gate: fail on drift
  mirror_bridge diff src/ --output build/
EOF
}

# Command: watch - Live reload during development
# Watches header files for changes and recompiles bindings automatically
cmd_watch() {
    local src_dir=""
    local module_name=""
    local interval=2

    while [ $# -gt 0 ]; do
        case "$1" in
            --help|-h) show_watch_help; exit 0 ;;
            --module|-m) module_name="$2"; shift 2 ;;
            --output|-o) OUTPUT_DIR="$2"; shift 2 ;;
            --lang|-l) LANG="$2"; shift 2 ;;
            --interval|-i) interval="$2"; shift 2 ;;
            --pch) USE_PCH="--pch"; shift ;;
            *) src_dir="$1"; shift ;;
        esac
    done

    [ -z "$src_dir" ] && { echo -e "${RED}Error: Source directory required${NC}"; exit 1; }
    [ -z "$module_name" ] && { echo -e "${RED}Error: Module name required (--module)${NC}"; exit 1; }

    echo -e "${CYAN}Mirror Bridge Watch Mode${NC}"
    echo -e "Watching ${BLUE}$src_dir${NC} for changes..."
    echo -e "Module: ${GREEN}$module_name${NC} | Language: ${GREEN}$LANG${NC} | Interval: ${interval}s"
    echo -e "Press Ctrl+C to stop."
    echo ""

    local checksum_file
    checksum_file=$(mktemp) || { echo -e "${RED}Error: failed to create temp file${NC}"; exit 1; }

    # Clean up temp files on exit (Ctrl+C, termination, or normal exit)
    trap 'rm -f "$checksum_file"; exit' INT TERM EXIT

    compute_header_checksums "$src_dir" > "$checksum_file"

    # Initial build
    echo -e "${YELLOW}[$(date +%H:%M:%S)]${NC} Initial build..."
    cmd_generate "$src_dir" --module "$module_name" --lang "$LANG" $USE_PCH 2>&1 && \
        echo -e "${GREEN}[$(date +%H:%M:%S)] Build successful${NC}" || \
        echo -e "${RED}[$(date +%H:%M:%S)] Build failed${NC}"

    # Watch loop
    while true; do
        sleep "$interval"

        local new_checksums
        new_checksums=$(mktemp) || continue
        compute_header_checksums "$src_dir" > "$new_checksums"

        if ! diff -q "$checksum_file" "$new_checksums" > /dev/null 2>&1; then
            local changed_files
            changed_files=$(diff "$checksum_file" "$new_checksums" | grep ">" | awk '{print $3}')
            echo ""
            echo -e "${YELLOW}[$(date +%H:%M:%S)]${NC} Changes detected:"
            for f in $changed_files; do
                echo -e "  ${BLUE}$f${NC}"
            done

            echo -e "${YELLOW}[$(date +%H:%M:%S)]${NC} Rebuilding..."
            cmd_generate "$src_dir" --module "$module_name" --lang "$LANG" $USE_PCH 2>&1 && \
                echo -e "${GREEN}[$(date +%H:%M:%S)] Build successful${NC}" || \
                echo -e "${RED}[$(date +%H:%M:%S)] Build failed${NC}"

            cp "$new_checksums" "$checksum_file"
        fi

        rm -f "$new_checksums"
    done

    rm -f "$checksum_file"
}

# Compute checksums of all header files in a directory
compute_header_checksums() {
    local dir="$1"
    find "$dir" -maxdepth 3 \( -name "*.hpp" -o -name "*.h" \) -exec md5sum {} \; 2>/dev/null | sort
}

