# Command: diff - Show binding surface changes between builds
# Compares current class signatures with the last recorded snapshot
cmd_diff() {
    local src_dir=""
    local update_snapshot=0
    local check_mode=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --help|-h) show_diff_help; exit 0 ;;
            --output|-o) OUTPUT_DIR="$2"; shift 2 ;;
            --update|-u) update_snapshot=1; shift ;;
            --check) check_mode=1; shift ;;
            --json) JSON_MODE=1; shift ;;
            *) src_dir="$1"; shift ;;
        esac
    done

    if [ $JSON_MODE -eq 1 ]; then
        exec 3>&1 1>&2
    fi

    [ -z "$src_dir" ] && { echo -e "${RED}Error: Source directory required${NC}"; json_fail "args" "Source directory required"; }

    local snapshot_dir="$OUTPUT_DIR/.mirror_bridge"
    local snapshot_file="$snapshot_dir/binding_snapshot.txt"

    local current_sig
    current_sig=$(scan_binding_signatures "$src_dir")

    if [ ! -f "$snapshot_file" ]; then
        # In check mode a missing snapshot is an error, not a fresh start:
        # CI should compare against a committed snapshot, never silently
        # create one and pass.
        if [ $check_mode -eq 1 ]; then
            echo -e "${RED}Error: No snapshot found at $snapshot_file${NC}"
            echo -e "${YELLOW}Run 'mirror_bridge diff $src_dir --update' locally and commit the snapshot.${NC}"
            if [ $JSON_MODE -eq 1 ]; then
                printf '{"status":"error","changed":null,"reason":"no snapshot found","snapshot":"%s"}\n' \
                    "$(json_escape "$snapshot_file")" >&3
            fi
            exit 2
        fi
        echo -e "${YELLOW}No previous snapshot found. Creating initial snapshot.${NC}"
        mkdir -p "$snapshot_dir"
        printf '%s\n' "$current_sig" > "$snapshot_file"
        echo -e "${GREEN}Snapshot saved to $snapshot_file${NC}"
        if [ $JSON_MODE -eq 1 ]; then
            printf '{"status":"ok","changed":false,"snapshot_created":true}\n' >&3
        fi
        return 0
    fi

    local previous_sig
    previous_sig=$(cat "$snapshot_file")

    if [ "$current_sig" = "$previous_sig" ]; then
        echo -e "${GREEN}No binding surface changes detected.${NC}"
        if [ $JSON_MODE -eq 1 ]; then
            printf '{"status":"ok","changed":false}\n' >&3
        fi
        return 0
    fi

    echo -e "${CYAN}Binding Surface Changes:${NC}"
    echo "========================"

    diff <(printf '%s\n' "$previous_sig") <(printf '%s\n' "$current_sig") || true

    local added removed
    added=$(diff <(printf '%s\n' "$previous_sig") <(printf '%s\n' "$current_sig") | grep -c "^>" || true)
    removed=$(diff <(printf '%s\n' "$previous_sig") <(printf '%s\n' "$current_sig") | grep -c "^<" || true)

    echo ""
    echo -e "  ${GREEN}+ $added added${NC}  ${RED}- $removed removed${NC}"

    if [ $JSON_MODE -eq 1 ]; then
        printf '{"status":"ok","changed":true,"added":%s,"removed":%s}\n' "$added" "$removed" >&3
    fi

    # In check mode drift is a failure: exit non-zero so CI/agents catch
    # binding-surface changes that weren't snapshotted intentionally.
    if [ "$check_mode" -eq 1 ]; then
        echo -e "${RED}Binding surface drifted from snapshot (--check).${NC}"
        exit 1
    fi

    # Update snapshot: via flag, or interactively if terminal is attached
    if [ "$update_snapshot" -eq 1 ]; then
        printf '%s\n' "$current_sig" > "$snapshot_file"
        echo -e "${GREEN}Snapshot updated.${NC}"
    elif [ -t 0 ]; then
        echo ""
        read -p "Update snapshot? [y/N] " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            printf '%s\n' "$current_sig" > "$snapshot_file"
            echo -e "${GREEN}Snapshot updated.${NC}"
        fi
    else
        echo -e "${YELLOW}Run with --update to save new snapshot.${NC}"
    fi
}

# Scan headers to extract binding signatures (class names, members, methods)
scan_binding_signatures() {
    local src_dir="$1"

    # Find headers and sort for deterministic output across platforms
    find "$src_dir" -maxdepth 1 \( -name "*.hpp" -o -name "*.h" \) 2>/dev/null | sort | while read -r header; do
        [ -f "$header" ] || continue
        local basename
        basename=$(basename "$header")

        # Skip files marked with MIRROR_BRIDGE_SKIP
        grep -q "MIRROR_BRIDGE_SKIP" "$header" 2>/dev/null && continue

        printf '=== %s ===\n' "$basename"

        # Extract class/struct names
        grep -E "^(struct|class)\s+\w+" "$header" 2>/dev/null | while read -r line; do
            local class_name
            class_name=$(printf '%s' "$line" | grep -oE "(struct|class)\s+\w+" | awk '{print $2}')
            printf '  class: %s\n' "$class_name"
        done

        # Extract public data members
        grep -E "^\s+(int|double|float|bool|std::\w+|unsigned|long|short|char)\s+\w+" "$header" 2>/dev/null | \
            sed 's/^\s*/  member: /' | head -50

        # Extract method signatures (skip control flow, comments, preprocessor)
        grep -E "^\s+\w+.*\w+\(.*\)" "$header" 2>/dev/null | \
            grep -v "^\s*//" | grep -v "^\s*#" | grep -v "^\s*if\b" | \
            grep -v "^\s*for\b" | grep -v "^\s*while\b" | grep -v "^\s*return\b" | \
            sed 's/^\s*/  method: /' | head -50

        echo ""
    done
}

show_diff_help() {
    cat << EOF
${CYAN}mirror_bridge diff${NC} - Show binding surface changes

${YELLOW}Usage:${NC}
  mirror_bridge diff <src_dir> [--output <dir>]

Compares the current class definitions in <src_dir> against a stored
snapshot, showing added/removed members and methods. Useful for catching
accidental ABI breaks during development.

${YELLOW}Options:${NC}
  --output, -o    Build directory for storing snapshots (default: build)
  --update, -u    Update the snapshot without prompting (CI-friendly)
