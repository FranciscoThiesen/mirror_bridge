# Include spelling for a header: relative to src_dir, or — when the user
# passed -I directories — relative to the broadest include root containing
# it, so the #include matches what the library's own headers use
# ("open3d/geometry/Foo.h" rather than "Foo.h").
header_include_spelling() {
    local header_file="$1"
    local src_dir="$2"
    local rel_path
    rel_path=$(realpath --relative-to="$src_dir" "$header_file")
    local abs_header
    abs_header=$(realpath "$header_file" 2>/dev/null || echo "$header_file")
    local best=""
    local inc
    for inc in "${_INCLUDE_DIRS[@]:-}"; do
        [ -z "$inc" ] && continue
        local abs_inc
        abs_inc=$(realpath "$inc" 2>/dev/null || echo "$inc")
        if [[ "$abs_header" == "$abs_inc"/* ]]; then
            local candidate="${abs_header#$abs_inc/}"
            # Prefer the path with more directory components (broader root)
            if [ -z "$best" ] || [ "${#candidate}" -gt "${#best}" ]; then
                best="$candidate"
            fi
        fi
    done
    echo "${best:-$rel_path}"
}

# Eigen ships as headers only; find the usual install location so users
# don't have to pass -I for it.
detect_eigen_dir() {
    local src_dir="$1"
    if grep -rq "Eigen/" "$src_dir" 2>/dev/null; then
        local eigen_path
        for eigen_path in /usr/include/eigen3 /usr/local/include/eigen3 /opt/homebrew/include/eigen3; do
            if [ -d "$eigen_path" ]; then
                echo "$eigen_path"
                return 0
            fi
        done
    fi
    return 0
}

# Discover classes in source directory.
#
# Handles nested classes correctly by tracking C++ brace depth and class scope:
# a class declared inside another class is reported as `Outer::Inner` (scopes
# joined with ::), so it can be referenced from binding code without needing
# the original class body. Namespaces are NOT joined — they're handled by the
# `using namespace` directives emitted elsewhere.
discover_classes() {
    local src_dir="$1"
    local -n classes_ref=$2
    local -n headers_ref=$3

    local header_files
    header_files=$(find "$src_dir" -type f \( -name "*.hpp" -o -name "*.h" \) | sort)

    if [ -z "$header_files" ]; then
        echo -e "${RED}Error: No header files found in $src_dir${NC}"
        exit 1
    fi

    # Python parser that understands nested classes. Emits one line per class:
    #   QUALIFIED_NAME\tLINE_NUMBER_OF_DECLARATION
    # Line numbers let the caller check the preceding line for MIRROR_BRIDGE_SKIP.
    #
    # Classes declared inside other classes are reported as Outer::Inner;
    # namespace scope is NOT joined (the `using namespace ...` emission elsewhere
    # handles that).
    local parser_script
    parser_script=$(cat <<'PYSCRIPT'
import re, sys

path = sys.argv[1]
try:
    with open(path, encoding='utf-8', errors='ignore') as f:
        raw = f.read()
except Exception:
    sys.exit(0)

# Strip comments and string/char literals while preserving line numbers so
# error messages and MIRROR_BRIDGE_SKIP lookups remain accurate.
def keep_newlines(m):
    return '\n' * m.group(0).count('\n')

content = re.sub(r'/\*.*?\*/', keep_newlines, raw, flags=re.DOTALL)
content = re.sub(r'//[^\n]*', '', content)
content = re.sub(r'"(?:[^"\\]|\\.)*"', '""', content)
content = re.sub(r"'(?:[^'\\]|\\.)*'", "''", content)

# Tokenize to {, }, ;, class NAME, struct NAME, access labels, and
# 'template' (for template-parameter skipping).
token_re = re.compile(
    r'\b(class|struct)\b\s+([A-Za-z_]\w*)'      # 1,2: keyword + name
    r'|\b(public|private|protected)\s*:'        # 3: access label
    r'|\btemplate\b'                            # template keyword
    r'|([{};])'                                 # 4: punctuation we care about
)

tokens = []
for m in token_re.finditer(content):
    line_no = content.count('\n', 0, m.start()) + 1
    if m.group(1):   # class/struct declaration
        tokens.append(('decl', (m.group(1), m.group(2)), line_no, m.end()))
    elif m.group(3):
        tokens.append(('access', m.group(3), line_no, m.end()))
    elif m.group(0) == 'template':
        tokens.append(('template', None, line_no, m.end()))
    else:            # {, }, ;
        tokens.append((m.group(4), None, line_no, m.end()))

# Walk tokens. A 'decl' followed (eventually) by '{' at depth D pushes the name
# onto the class stack at depth D. A 'decl' followed by ';' is a forward
# declaration and is dropped. 'template' makes the *next* token sequence skip
# a matching <...> block — we handle that by scanning the raw text between the
# template token and its balanced '>'.
depth = 0
# Stack entries: [name, opened_at_depth, cur_access, visible]
# cur_access starts 'private' for class, 'public' for struct, and tracks
# access labels so private nested classes are never emitted (binding an
# inaccessible type is ill-formed — Clipper2's ClipperOffset::Group taught
# us this). `visible` is the AND of the enclosing chain's accessibility.
class_stack = []
pending = None       # ((keyword, name), line_no) awaiting a '{'
skip_until_pos = 0   # positions up to here were eaten by a template<...>
skip_next_decl = False  # True after a template<...> block — next decl is a template
results = []

def skip_template_params(start):
    # Find the matching '>' for a '<' that follows 'template'.
    lt = content.find('<', start)
    if lt < 0:
        return start
    d = 1
    i = lt + 1
    while i < len(content) and d > 0:
        if content[i] == '<':
            d += 1
        elif content[i] == '>':
            d -= 1
        i += 1
    return i

for kind, payload, line_no, end_pos in tokens:
    if end_pos <= skip_until_pos:
        continue
    if kind == 'template':
        skip_until_pos = skip_template_params(end_pos)
        skip_next_decl = True
        continue
    if kind == 'decl':
        if skip_next_decl:
            # Template class — can't be bound directly (needs instantiation).
            # Still push a placeholder so the brace matching stays consistent;
            # we just never emit it.
            pending = (('class', '__mb_template__'), line_no)
            skip_next_decl = False
        else:
            pending = (payload, line_no)
    elif kind == 'access':
        # Attribute the label to the innermost open class whose body we're in
        if class_stack and depth == class_stack[-1][1] + 1:
            class_stack[-1][2] = payload
    elif kind == '{':
        if pending is not None:
            (kw, name), decl_line = pending
            # Nested classes are only bindable when every enclosing class
            # section is public at the point of declaration.
            parent_public = (not class_stack) or (
                class_stack[-1][3] and class_stack[-1][2] == 'public')
            default_access = 'private' if kw == 'class' else 'public'
            class_stack.append([name, depth, default_access, parent_public])
            if name != '__mb_template__' and parent_public and \
               not any(entry[0] == '__mb_template__' for entry in class_stack[:-1]):
                qual = '::'.join(entry[0] for entry in class_stack)
                results.append((qual, decl_line))
            pending = None
        depth += 1
    elif kind == '}':
        depth -= 1
        while class_stack and class_stack[-1][1] >= depth:
            class_stack.pop()
    elif kind == ';':
        pending = None  # forward declaration — discard
        skip_next_decl = False

for name, lineno in results:
    print(f"{name}\t{lineno}")
PYSCRIPT
    )

    while IFS= read -r header_file; do
        local rel_path
        rel_path=$(header_include_spelling "$header_file" "$src_dir")

        # Skip files marked with MIRROR_BRIDGE_SKIP_FILE
        if grep -q "MIRROR_BRIDGE_SKIP_FILE" "$header_file" 2>/dev/null; then
            [ $VERBOSE -eq 1 ] && echo -e "${BLUE}  Skipping file: $rel_path${NC}"
            continue
        fi

        # Run the Python parser on this header.
        while IFS=$'\t' read -r class_name line_num; do
            [ -z "$class_name" ] && continue

            # Honor MIRROR_BRIDGE_SKIP annotation on the line before the declaration.
            if [ -n "$line_num" ] && [ "$line_num" -gt 1 ]; then
                local prev_line=$((line_num - 1))
                if sed -n "${prev_line}p" "$header_file" | grep -q "MIRROR_BRIDGE_SKIP"; then
                    [ $VERBOSE -eq 1 ] && echo -e "${BLUE}  Skipping: $class_name (marked SKIP)${NC}"
                    continue
                fi
            fi

            classes_ref+=("$class_name")
            headers_ref+=("$rel_path")
            echo -e "  ${GREEN}✓${NC} Found: $class_name in $rel_path"
        done < <(python3 -c "$parser_script" "$header_file" 2>/dev/null)
    done <<< "$header_files"
}

# Generate binding file for a specific language
generate_binding_file() {
    local lang="$1"
    local module_name="$2"
    local output_file="$3"
    local -n classes=$4
    local -n headers=$5
    local src_dir="$6"

    local include_header
    local module_macro
    local bind_func

    case "$lang" in
        python)
            include_header="mirror_bridge.hpp"
            module_macro="MIRROR_BRIDGE_MODULE"
            # when_bindable: on real-world headers, skip (with a warning)
            # classes that can't be bound instead of failing the module
            bind_func="mirror_bridge::bind_class_when_bindable"
            ;;
        lua)
            include_header="lua/mirror_bridge_lua.hpp"
            module_macro="MIRROR_BRIDGE_LUA_MODULE"
            bind_func="mirror_bridge::lua::bind_class"
            ;;
        js|javascript)
            include_header="javascript/mirror_bridge_javascript.hpp"
            module_macro="MIRROR_BRIDGE_JS_MODULE"
            bind_func="mirror_bridge::javascript::bind_class"
            ;;
    esac

    cat > "$output_file" << EOF
// Auto-generated by mirror_bridge
// Source: $src_dir
// Language: $lang
// Generated: $(date)

#include "$include_header"
EOF

    # Add unique header includes
    declare -A included
    for header in "${headers[@]}"; do
        if [ -z "${included["$header"]}" ]; then
            echo "#include \"$header\"" >> "$output_file"
            included["$header"]=1
        fi
    done
    # Headers without classes that the template planner found functions or
    # templates in
    if [ -n "$TEMPLATE_INCLUDES_FILE" ] && [ -s "$TEMPLATE_INCLUDES_FILE" ]; then
        while IFS= read -r header; do
            if [ -n "$header" ] && [ -z "${included["$header"]}" ]; then
                echo "#include \"$header\"" >> "$output_file"
                included["$header"]=1
            fi
        done < "$TEMPLATE_INCLUDES_FILE"
    fi

    echo "" >> "$output_file"

    # Detect namespaces and emit using directives, using a Python helper that
    # tracks brace depth properly. Collect all files in one invocation.
    declare -A ns_seen
    local ns_script
    ns_script=$(cat <<'PYSCRIPT'
import re, sys
seen = set()
for path in sys.argv[1:]:
    try:
        with open(path, encoding='utf-8', errors='ignore') as f:
            text = f.read()
    except Exception:
        continue
    text = re.sub(r'//[^\n]*', '', text)
    text = re.sub(r'/\*.*?\*/', '', text, flags=re.DOTALL)
    depth = 0
    ns_stack = []
    i = 0
    while i < len(text):
        ch = text[i]
        if ch == '{':
            depth += 1
        elif ch == '}':
            depth -= 1
            while ns_stack and ns_stack[-1][1] >= depth:
                ns_stack.pop()
        elif ch == 'n':
            m = re.match(r'namespace\s+([a-zA-Z_][a-zA-Z0-9_:]*)\s*\{', text[i:])
            if m:
                ns_name = m.group(1)
                if ns_name != 'std':
                    ns_stack.append((ns_name, depth))
                    fqn = '::'.join(n for n, _ in ns_stack)
                    if fqn and fqn not in seen:
                        seen.add(fqn)
                        print(fqn)
                depth += 1
                i += m.end()
                continue
        i += 1
PYSCRIPT
    )

    local -a ns_paths=()
    for header in "${headers[@]}"; do
        # Header may be relative to src_dir OR to an include root.
        # Try each form.
        local full_path=""
        if [ -f "$src_dir/$header" ]; then
            full_path="$src_dir/$header"
        elif [ -f "$header" ]; then
            full_path="$header"
        else
            # Try each -I include dir
            for inc in "${_INCLUDE_DIRS[@]:-}"; do
                if [ -n "$inc" ] && [ -f "$inc/$header" ]; then
                    full_path="$inc/$header"; break
                fi
            done
        fi
        [ -n "$full_path" ] && ns_paths+=("$full_path")
    done

    if [ ${#ns_paths[@]} -gt 0 ]; then
        while IFS= read -r fqn; do
            if [ -n "$fqn" ] && [ -z "${ns_seen["$fqn"]}" ]; then
                echo "using namespace $fqn;" >> "$output_file"
                ns_seen["$fqn"]=1
            fi
        done < <(python3 -c "$ns_script" "${ns_paths[@]}" 2>/dev/null)
    fi

    echo "" >> "$output_file"

    # Generate module.
    # Python/Lua/JS class names are the simple name (last segment after ::),
    # since they're flat identifiers in the target language. The C++ template
    # argument keeps the fully-qualified scope.
    echo "$module_macro($module_name," >> "$output_file"
    for class_name in "${classes[@]}"; do
        local simple_name="${class_name##*::}"
        if [ "$lang" = "js" ] || [ "$lang" = "javascript" ]; then
            echo "    $bind_func<$class_name>(env, m, \"$simple_name\");" >> "$output_file"
        elif [ "$lang" = "lua" ]; then
            echo "    $bind_func<$class_name>(L, \"$simple_name\");" >> "$output_file"
        else
            # --release-gil: drop the GIL while C++ method bodies run
            # (Python backend only; Lua/JS have no GIL equivalent)
            if [ "${RELEASE_GIL:-0}" -eq 1 ]; then
                echo "    $bind_func<$class_name>(m, \"$simple_name\").release_gil();" >> "$output_file"
            else
                echo "    $bind_func<$class_name>(m, \"$simple_name\");" >> "$output_file"
            fi
        fi
    done

    # Free functions and template instantiations the planner approved
    # (Python only; see plan_templates)
    if [ "$lang" = "python" ] && [ -n "$TEMPLATE_LINES_FILE" ] && [ -s "$TEMPLATE_LINES_FILE" ]; then
        cat "$TEMPLATE_LINES_FILE" >> "$output_file"
    fi

    echo ")" >> "$output_file"
}

# Template instantiation planning (Python backend). Nothing in a header says
# which instantiations of its templates to bind, so tools/mirror_bridge_templates.py
# derives candidates from the API surface through reflection and lets the
# compiler decide which ones exist (discover/probe rounds). It also binds
# non-overloaded free functions. On success the binding lines wait in
# TEMPLATE_LINES_FILE (plus TEMPLATE_INCLUDES_FILE for headers the class scan
# had no reason to include); on failure the module degrades to classes only.
TEMPLATE_LINES_FILE=""
TEMPLATE_INCLUDES_FILE=""
TEMPLATE_JSON_FILE=""
plan_templates() {
    local module_name="$1"
    local src_dir="$2"
    local -n classes_ref=$3
    local -n headers_ref=$4
    shift 4
    local extra_includes=("$@")

    TEMPLATE_LINES_FILE=""
    TEMPLATE_INCLUDES_FILE=""
    TEMPLATE_JSON_FILE=""
    local work="$OUTPUT_DIR/.mirror_bridge/plan/$module_name"
    mkdir -p "$work"

    # Every header in src_dir, flagged when the class scan already includes it
    declare -A already
    local h
    for h in "${headers_ref[@]}"; do already["$h"]=1; done
    : > "$work/headers.txt"
    local header_file
    while IFS= read -r header_file; do
        [ -z "$header_file" ] && continue
        grep -q "MIRROR_BRIDGE_SKIP_FILE" "$header_file" 2>/dev/null && continue
        local rel
        rel=$(header_include_spelling "$header_file" "$src_dir")
        printf '%s\t%s\n' "$rel" "${already["$rel"]:-0}" >> "$work/headers.txt"
    done < <(find "$src_dir" -type f \( -name "*.hpp" -o -name "*.h" \) | sort)
    printf '%s\n' "${classes_ref[@]}" > "$work/classes.txt"

    local -a args=(--cxx "$CXX_BIN" --cxx-flags "$CXX_REFLECT_FLAGS" --project-root "$PROJECT_ROOT"
                   --src-dir "$src_dir" --module "$module_name" --work "$work"
                   --headers-file "$work/headers.txt" --classes-file "$work/classes.txt"
                   --emit "$work/bindings.inc" --includes-out "$work/includes.txt"
                   --report "$OUTPUT_DIR/${module_name}_plan.txt" --json-out "$work/plan.json"
                   --template-cap "$TEMPLATE_CAP")
    local inc
    for inc in "${extra_includes[@]}"; do
        [ -n "$inc" ] && args+=(-I "$inc")
    done
    local eigen_path
    eigen_path=$(detect_eigen_dir "$src_dir")
    [ -n "$eigen_path" ] && args+=(--eigen-dir "$eigen_path")
    [ "$RELEASE_GIL" -eq 1 ] && args+=(--release-gil)
    [ "$VERBOSE" -eq 1 ] && args+=(--verbose)
    local spec
    for spec in "${INSTANTIATE[@]}"; do
        [ -n "$spec" ] && args+=(--instantiate "$spec")
    done

    echo -e "${YELLOW}Planning template instantiations...${NC}"
    if python3 "$PROJECT_ROOT/tools/mirror_bridge_templates.py" "${args[@]}"; then
        TEMPLATE_LINES_FILE="$work/bindings.inc"
        TEMPLATE_INCLUDES_FILE="$work/includes.txt"
        TEMPLATE_JSON_FILE="$work/plan.json"
        return 0
    fi
    echo -e "${YELLOW}  Templates and free functions not bound (see $work/planner.log); binding classes only.${NC}"
    return 1
}

# Compile binding for a specific language
compile_binding() {
    local lang="$1"
    local module_name="$2"
    local binding_file="$3"
    local output_dir="$4"
    local src_dir="$5"
    local pch_path="$6"
    shift 6
    local extra_includes=("$@")

    local output_ext
    local compile_flags
    local link_flags=""

    case "$lang" in
        python)
            output_ext=".so"
            compile_flags="$(python3-config --includes)"
            link_flags="$(python3-config --ldflags 2>/dev/null || echo "")"
            ;;
        lua)
            output_ext=".so"
            compile_flags="-I/usr/include/lua5.4"
            link_flags="-llua5.4"
            ;;
        js|javascript)
            output_ext=".node"
            compile_flags="-I/usr/include/node"
            ;;
    esac

    # Lua modules go to a lua/ subdirectory: Python and Lua would otherwise
    # both emit <module>.so and --lang all would silently clobber one with
    # the other. The file name itself must stay <module>.so because Lua's
    # require("module") derives the luaopen_<module> symbol from it.
    local output_file
    if [ "$lang" = "lua" ]; then
        mkdir -p "$output_dir/lua"
        output_file="$output_dir/lua/${module_name}${output_ext}"
    else
        output_file="$output_dir/${module_name}${output_ext}"
    fi

    local cmd="$CXX_BIN $CXX_REFLECT_FLAGS \
        -I. -I$src_dir -I$PROJECT_ROOT \
        -fPIC -shared -O3 -DNDEBUG \
        -Wno-deprecated-declarations"

    # Add user-supplied -I directories
    for inc in "${extra_includes[@]}"; do
        [ -n "$inc" ] && cmd="$cmd -I$inc"
    done

    local eigen_path
    eigen_path=$(detect_eigen_dir "$src_dir")
    if [ -n "$eigen_path" ]; then
        cmd="$cmd -I$eigen_path"
        [ $VERBOSE -eq 1 ] && echo -e "${BLUE}  Auto-detected Eigen at $eigen_path${NC}"
    fi

    if [ -n "$pch_path" ] && [ -f "$pch_path" ]; then
        case "$CXX_BIN" in
            # -include-pch is clang-only; GCC picks up a .gch automatically
            # when it sits next to the included header, so skip the flag.
            *clang*) cmd="$cmd -include-pch $pch_path" ;;
        esac
    fi

    # LINK_ARGS: extra objects/archives/flags for libraries that aren't
    # header-only (e.g. --link-args "/path/libClipper2.a")
    cmd="$cmd $compile_flags $binding_file -o $output_file $link_flags ${LINK_ARGS:-}"

    # Capture the full compiler output so failures can be reported with
    # context (and machine-readably in --json mode via LAST_COMPILE_LOG).
    # Track the exit code explicitly: checking only for the output file
    # would let a stale .so from a previous run mask a failed compile.
    LAST_COMPILE_LOG=""
    local compile_rc=0
    if [ $VERBOSE -eq 1 ]; then
        echo -e "${BLUE}$cmd${NC}"
        LAST_COMPILE_LOG=$(eval "$cmd" 2>&1) || compile_rc=$?
        [ -n "$LAST_COMPILE_LOG" ] && echo "$LAST_COMPILE_LOG"
    else
        LAST_COMPILE_LOG=$(eval "$cmd" 2>&1) || compile_rc=$?
        echo "$LAST_COMPILE_LOG" | grep -E "(error|Error)" || true
    fi

    if [ $compile_rc -eq 0 ] && [ -f "$output_file" ]; then
        echo -e "${GREEN}✓ Built: $output_file${NC}"
        LAST_OUTPUT_FILE="$output_file"
        return 0
    else
        echo -e "${RED}✗ Failed to build: $output_file${NC}"
        return 1
    fi
}

# Write <module>.pyi next to the built Python module. The module itself is
# the source of truth: importing it and calling __mirror_bridge_stubs__()
# returns reflection-exact stub content collected during bind_class — no
# parsing of the compiled artifact involved.
emit_stubs() {
    local module_name="$1"
    local output_dir="$2"
    local stub_file="$output_dir/${module_name}.pyi"

    if LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH:-}" python3 - "$output_dir" "$module_name" "$stub_file" << 'PYEOF'
import importlib, sys
out_dir, mod_name, stub_file = sys.argv[1], sys.argv[2], sys.argv[3]
sys.path.insert(0, out_dir)
mod = importlib.import_module(mod_name)
content = mod.__mirror_bridge_stubs__()
with open(stub_file, "w") as f:
    f.write(content)
PYEOF
    then
        echo -e "${GREEN}✓ Stubs: $stub_file${NC}"
    else
        echo -e "${YELLOW}⚠ Stub generation skipped (importing the module failed)${NC}"
    fi
}

# Command: generate
cmd_generate() {
    local src_dir=""
    local module_name=""
    local include_dirs=()

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help) show_generate_help; exit 0 ;;
            --module) module_name="$2"; shift 2 ;;
            --lang) LANG="$2"; shift 2 ;;
            -o|--output) OUTPUT_DIR="$2"; shift 2 ;;
            -k|--keep-generated) KEEP_GENERATED=1; shift ;;
            -v|--verbose) VERBOSE=1; shift ;;
            -f|--force) FORCE_REBUILD=1; shift ;;
            --json) JSON_MODE=1; shift ;;
            --release-gil) RELEASE_GIL=1; shift ;;
            --stubs) GEN_STUBS=1; shift ;;
            --link-args) LINK_ARGS="$2"; shift 2 ;;
            --instantiate) INSTANTIATE+=("$2"); shift 2 ;;
            --template-cap) TEMPLATE_CAP="$2"; shift 2 ;;
            --no-templates) NO_TEMPLATES=1; shift ;;
            -I) include_dirs+=("$2"); shift 2 ;;
            --pch)
                USE_PCH="1"
                if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
                    PCH_PATH="$2"; shift 2
                else
                    PCH_PATH="auto"; shift
                fi
                ;;
            -*)
                echo -e "${RED}Error: Unknown option $1${NC}"
                show_generate_help
                exit 1
                ;;
            *)
                if [ -z "$src_dir" ]; then
                    src_dir="$1"
                fi
                shift
                ;;
        esac
    done

    # In JSON mode stdout must carry only the final JSON object: park the
    # real stdout on fd 3 and route all progress chatter to stderr.
    if [ $JSON_MODE -eq 1 ]; then
        exec 3>&1 1>&2
    fi

    # Validate
    [ -z "$src_dir" ] && { echo -e "${RED}Error: No source directory specified${NC}"; show_generate_help; json_fail "args" "No source directory specified"; }
    [ -z "$module_name" ] && { echo -e "${RED}Error: No module name specified (use --module)${NC}"; show_generate_help; json_fail "args" "No module name specified (use --module)"; }
    [ ! -d "$src_dir" ] && { echo -e "${RED}Error: Directory not found: $src_dir${NC}"; json_fail "args" "Directory not found: $src_dir"; }

    src_dir=$(realpath "$src_dir")
    OUTPUT_DIR=$(realpath "$OUTPUT_DIR" 2>/dev/null || echo "$OUTPUT_DIR")
    mkdir -p "$OUTPUT_DIR"

    echo -e "${CYAN}Mirror Bridge - Generate Bindings${NC}"
    echo -e "${CYAN}==================================${NC}"
    echo ""
    echo -e "Source:  ${YELLOW}$src_dir${NC}"
    echo -e "Module:  ${YELLOW}$module_name${NC}"
    echo -e "Lang:    ${YELLOW}$LANG${NC}"
    echo ""

    # Discover classes (pass include dirs so headers get proper paths)
    echo -e "${YELLOW}Scanning for classes...${NC}"
    declare -a CLASSES
    declare -a HEADERS
    # Make include dirs visible to discover_classes (bash arrays are process-local)
    _INCLUDE_DIRS=("${include_dirs[@]}")
    discover_classes "$src_dir" CLASSES HEADERS

    # Determine languages to generate
    local languages=()
    case "$LANG" in
        all) languages=("python" "lua" "js") ;;
        python|lua|js|javascript) languages=("$LANG") ;;
        *) echo -e "${RED}Error: Unknown language: $LANG${NC}"; json_fail "args" "Unknown language: $LANG" "Valid values: python, lua, js, all" ;;
    esac

    # Python modules also get free functions and template instantiations,
    # so a header with no plain classes can still produce a module.
    local plans_templates=0
    if [ $NO_TEMPLATES -eq 0 ]; then
        for lang in "${languages[@]}"; do
            [ "$lang" = "python" ] && plans_templates=1
        done
    fi

    if [ ${#CLASSES[@]} -eq 0 ] && [ $plans_templates -eq 0 ]; then
        echo -e "${RED}Error: No classes found in $src_dir${NC}"
        json_fail "discover" "No classes found in $src_dir" \
            "Check that headers contain struct/class definitions and are not all marked MIRROR_BRIDGE_SKIP_FILE"
    fi

    echo ""
    echo -e "${GREEN}Discovered ${#CLASSES[@]} classes${NC}"
    echo ""

    if [ $plans_templates -eq 1 ]; then
        plan_templates "$module_name" "$src_dir" CLASSES HEADERS "${include_dirs[@]:-}" || true
        if [ ${#CLASSES[@]} -eq 0 ] && { [ -z "$TEMPLATE_LINES_FILE" ] || [ ! -s "$TEMPLATE_LINES_FILE" ]; }; then
            echo -e "${RED}Error: Nothing to bind in $src_dir${NC}"
            json_fail "discover" "No classes, functions or template instantiations found in $src_dir" \
                "Check that headers contain struct/class/function definitions and are not all marked MIRROR_BRIDGE_SKIP_FILE"
        fi
        echo ""
    fi

    # Auto-detect PCH if requested
    if [ "$PCH_PATH" = "auto" ]; then
        for pch_candidate in \
            "$OUTPUT_DIR/mirror_bridge_pch.hpp.gch" \
            "build/mirror_bridge_pch.hpp.gch" \
            "mirror_bridge_pch.hpp.gch"
        do
            if [ -f "$pch_candidate" ]; then
                PCH_PATH="$pch_candidate"
                echo -e "${GREEN}✓ Found PCH: $PCH_PATH${NC}"
                break
            fi
        done

        if [ "$PCH_PATH" = "auto" ]; then
            echo -e "${YELLOW}Note: No PCH found. Consider running 'mirror_bridge pch' for faster builds.${NC}"
            PCH_PATH=""
        fi
    fi

    # Generate and compile for each language. A failed language no longer
    # aborts the whole run (previously set -e killed the script on the first
    # failure): remaining languages still get built, failures are collected,
    # and the exit code reflects the overall result.
    local -a built_outputs=()
    local -a failed_langs=()
    local errors_json=""
    for lang in "${languages[@]}"; do
        echo -e "${YELLOW}Generating $lang bindings...${NC}"

        local binding_file="$OUTPUT_DIR/${module_name}_${lang}_binding.cpp"
        generate_binding_file "$lang" "$module_name" "$binding_file" CLASSES HEADERS "$src_dir"

        echo -e "${YELLOW}Compiling $lang module...${NC}"
        if compile_binding "$lang" "$module_name" "$binding_file" "$OUTPUT_DIR" "$src_dir" "$PCH_PATH" "${include_dirs[@]:-}"; then
            built_outputs+=("$LAST_OUTPUT_FILE")
            if [ "$GEN_STUBS" -eq 1 ] && [ "$lang" = "python" ]; then
                emit_stubs "$module_name" "$OUTPUT_DIR"
            fi
        else
            failed_langs+=("$lang")
            local first_err
            first_err=$(echo "$LAST_COMPILE_LOG" | grep -m1 -E "error" || echo "compilation failed")
            errors_json+="{\"lang\":\"$(json_escape "$lang")\",\"reason\":\"$(json_escape "$first_err")\",\"suggestion\":\"$(json_escape "$(suggest_fix "$LAST_COMPILE_LOG")")\"},"
        fi

        if [ $KEEP_GENERATED -eq 0 ]; then
            rm -f "$binding_file"
        fi
    done

    if [ $JSON_MODE -eq 1 ]; then
        local classes_json="" langs_json="" outputs_json="" i
        for i in "${!CLASSES[@]}"; do
            classes_json+="{\"name\":\"$(json_escape "${CLASSES[$i]}")\",\"header\":\"$(json_escape "${HEADERS[$i]}")\"},"
        done
        for lang in "${languages[@]}"; do
            langs_json+="\"$(json_escape "$lang")\","
        done
        for out in "${built_outputs[@]}"; do
            outputs_json+="\"$(json_escape "$out")\","
        done
        local status="ok"
        [ ${#failed_langs[@]} -gt 0 ] && status="error"
        # "templates": what the planner bound (functions, instantiations,
        # rejections with the compiler's reason); null when it did not run
        local templates_json="null"
        if [ -n "$TEMPLATE_JSON_FILE" ] && [ -s "$TEMPLATE_JSON_FILE" ]; then
            templates_json=$(cat "$TEMPLATE_JSON_FILE")
        fi
        printf '{"status":"%s","module":"%s","languages":[%s],"classes":[%s],"outputs":[%s],"errors":[%s],"templates":%s}\n' \
            "$status" "$(json_escape "$module_name")" "${langs_json%,}" \
            "${classes_json%,}" "${outputs_json%,}" "${errors_json%,}" "$templates_json" >&3
    fi

    echo ""
    if [ ${#failed_langs[@]} -gt 0 ]; then
        echo -e "${RED}✗ Failed languages: ${failed_langs[*]}${NC}"
        exit 1
    fi
    echo -e "${GREEN}✓ Successfully built bindings for: ${languages[*]}${NC}"
}

# Command: pch
cmd_pch() {
    local output_dir=""
    local build_type=""
    local pch_lang="python"

    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help) show_pch_help; exit 0 ;;
            --output) output_dir="$2"; shift 2 ;;
            --type) build_type="$2"; shift 2 ;;
            --lang) pch_lang="$2"; shift 2 ;;
            -v|--verbose) VERBOSE=1; shift ;;
            *)
                echo -e "${RED}Error: Unknown option $1${NC}"
                show_pch_help
                exit 1
                ;;
        esac
    done

    [ -z "$output_dir" ] && { echo -e "${RED}Error: --output required${NC}"; show_pch_help; exit 1; }
    [ -z "$build_type" ] && { echo -e "${RED}Error: --type required (release or debug)${NC}"; show_pch_help; exit 1; }

    mkdir -p "$output_dir"

    local opt_flags
    case "$build_type" in
        release) opt_flags="-O3 -DNDEBUG" ;;
        debug) opt_flags="-O0 -g" ;;
        *) echo -e "${RED}Error: Unknown build type: $build_type${NC}"; exit 1 ;;
    esac

    local pch_file="$PROJECT_ROOT/mirror_bridge_pch.hpp"
    local output_file="$output_dir/mirror_bridge_pch.hpp.gch"

    echo -e "${CYAN}Building Precompiled Header${NC}"
    echo -e "Type: ${YELLOW}$build_type${NC}"
    echo -e "Output: ${YELLOW}$output_file${NC}"
    echo ""

    local cmd="$CXX_BIN $CXX_REFLECT_FLAGS \
        -fPIC \
        $(python3-config --includes) \
        $opt_flags \
        -x c++-header $pch_file \
        -o $output_file"

    if [ $VERBOSE -eq 1 ]; then
        echo -e "${BLUE}$cmd${NC}"
    fi

    echo -e "${YELLOW}Compiling PCH (this takes ~600ms)...${NC}"
    eval "$cmd" 2>&1 | grep -v "mixture of designated" || true

    if [ -f "$output_file" ]; then
        echo -e "${GREEN}✓ PCH created: $output_file${NC}"
    else
        echo -e "${RED}✗ Failed to create PCH${NC}"
        exit 1
    fi
}

# Command: build
cmd_build() {
    local binding_file=""
    local include_dirs=()

    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                echo "Usage: mirror_bridge build <binding.cpp> [options]"
                exit 0
                ;;
            -o|--output) OUTPUT_DIR="$2"; shift 2 ;;
            -I) include_dirs+=("-I$2"); shift 2 ;;
            -v|--verbose) VERBOSE=1; shift ;;
            --pch)
                if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
                    PCH_PATH="$2"; shift 2
                else
                    PCH_PATH="auto"; shift
                fi
                ;;
            --lang) LANG="$2"; shift 2 ;;
            -*)
                echo -e "${RED}Error: Unknown option $1${NC}"
                exit 1
                ;;
            *)
                binding_file="$1"
                shift
                ;;
        esac
    done

    [ -z "$binding_file" ] && { echo -e "${RED}Error: No binding file specified${NC}"; exit 1; }
    [ ! -f "$binding_file" ] && { echo -e "${RED}Error: File not found: $binding_file${NC}"; exit 1; }

    mkdir -p "$OUTPUT_DIR"

    # Extract module name from filename
    local module_name
    module_name=$(basename "$binding_file" | sed 's/_binding\.cpp$//' | sed 's/\.cpp$//')

    echo -e "${CYAN}Building: $binding_file${NC}"
    compile_binding "$LANG" "$module_name" "$binding_file" "$OUTPUT_DIR" "." "$PCH_PATH"
}

