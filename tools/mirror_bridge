# Command: init - scaffold a ready-to-build project
cmd_init() {
    local project_name=""
    local lang="python"
    local with_ci=1
    local with_wheel=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --lang|-l) lang="$2"; shift 2 ;;
            --wheel) with_wheel=1; shift ;;
            --no-ci) with_ci=0; shift ;;
            -h|--help) show_init_help; exit 0 ;;
            -*)
                echo -e "${RED}Error: Unknown option '$1'${NC}"; show_init_help; exit 1 ;;
            *)
                if [ -z "$project_name" ]; then project_name="$1"; shift
                else echo -e "${RED}Error: Unexpected argument '$1'${NC}"; exit 1; fi ;;
        esac
    done

    if [ -z "$project_name" ]; then
        echo -e "${RED}Error: Project name required${NC}"
        show_init_help
        exit 1
    fi
    case "$lang" in python|lua|js|all) ;; *)
        echo -e "${RED}Error: Invalid language '$lang' (python|lua|js|all)${NC}"; exit 1 ;;
    esac

    # Module names become C identifiers (module init symbol) — enforce here
    # rather than letting the user discover it as a compile error later.
    local module_name
    module_name=$(echo "$project_name" | tr '-' '_' | tr '[:upper:]' '[:lower:]')
    if ! echo "$module_name" | grep -qE '^[a-z_][a-z0-9_]*$'; then
        echo -e "${RED}Error: '$project_name' cannot be turned into a valid module name${NC}"
        exit 1
    fi

    if [ -e "$project_name" ]; then
        echo -e "${RED}Error: '$project_name' already exists${NC}"
        exit 1
    fi

    echo -e "${CYAN}Creating project '$project_name' (module: $module_name, lang: $lang)${NC}"
    mkdir -p "$project_name/src"

    cat > "$project_name/src/greeter.hpp" << 'HEADER_EOF'
#pragma once

#include <string>
#include <vector>

// Every struct/class in src/ is bound automatically — no registration
// needed. Replace this example with your own classes.
// To keep a class out of the bindings, put // MIRROR_BRIDGE_SKIP on the
// line directly above it.
struct Greeter {
    std::string name = "world";
    int greet_count = 0;

    std::string greet() {
        ++greet_count;
        return "Hello, " + name + "!";
    }

    std::vector<int> counts_up_to(int n) const {
        std::vector<int> out;
        for (int i = 0; i < n; ++i) out.push_back(i);
        return out;
    }
};
HEADER_EOF

    if [ "$lang" = "python" ] || [ "$lang" = "all" ]; then
        cat > "$project_name/test_${module_name}.py" << PY_EOF
#!/usr/bin/env python3
import sys, os
sys.path.append(os.path.join(os.path.dirname(__file__), "build"))

import ${module_name}

g = ${module_name}.Greeter()
assert g.greet() == "Hello, world!"
g.name = "mirror_bridge"
assert g.greet() == "Hello, mirror_bridge!"
assert g.greet_count == 2
# Numeric vectors come back as array.array (zero-copy friendly) — compare as list
assert list(g.counts_up_to(4)) == [0, 1, 2, 3]
print("all checks passed")
PY_EOF
    fi

    if [ "$lang" = "lua" ] || [ "$lang" = "all" ]; then
        cat > "$project_name/test_${module_name}.lua" << LUA_EOF
package.cpath = "build/lua/?.so;" .. package.cpath
local m = require("${module_name}")

local g = m.Greeter()
assert(g:greet() == "Hello, world!")
g.name = "mirror_bridge"
assert(g:greet() == "Hello, mirror_bridge!")
assert(g.greet_count == 2)
print("all checks passed")
LUA_EOF
    fi

    if [ "$lang" = "js" ] || [ "$lang" = "all" ]; then
        cat > "$project_name/test_${module_name}.js" << JS_EOF
const assert = require('assert');
const m = require('./build/${module_name}.node');

const g = new m.Greeter();
assert.strictEqual(g.greet(), 'Hello, world!');
g.name = 'mirror_bridge';
assert.strictEqual(g.greet(), 'Hello, mirror_bridge!');
assert.strictEqual(g.greet_count, 2);
console.log('all checks passed');
JS_EOF
    fi

    local gen_lang="$lang"
    local test_cmd=""
    case "$lang" in
        python) test_cmd="python3 test_${module_name}.py" ;;
        lua)    test_cmd="lua5.4 test_${module_name}.lua" ;;
        js)     test_cmd="node test_${module_name}.js" ;;
        all)    test_cmd="python3 test_${module_name}.py" ;;
    esac

    cat > "$project_name/README.md" << README_EOF
# ${project_name}

C++ bindings generated by [Mirror Bridge](https://github.com/FranciscoThiesen/mirror_bridge)
— every class in \`src/\` is discovered and bound automatically.

## Build & test

Requires a C++26 reflection compiler (Bloomberg clang-p2996 or GCC 16+).
The easiest way is the Mirror Bridge dev container:

\`\`\`bash
mirror_bridge generate src/ --module ${module_name} --lang ${gen_lang}
${test_cmd}
\`\`\`

## Iterating

\`\`\`bash
# Rebuild automatically whenever a header changes
mirror_bridge watch src/ --module ${module_name} --lang ${gen_lang}

# See what the binding surface looks like after a change
mirror_bridge diff src/ --module ${module_name}
\`\`\`
README_EOF

    cat > "$project_name/.gitignore" << 'GI_EOF'
build/
*.so
*.node
__pycache__/
GI_EOF

    if [ $with_ci -eq 1 ]; then
        mkdir -p "$project_name/.github/workflows"
        cat > "$project_name/.github/workflows/bindings.yml" << CI_EOF
name: Bindings

on: [push, pull_request]

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    container:
      image: ghcr.io/franciscothiesen/mirror_bridge:latest
    steps:
      - uses: actions/checkout@v4
      - name: Generate bindings
        run: mirror_bridge generate src/ --module ${module_name} --lang ${gen_lang}
      - name: Run tests
        run: |
          export LD_LIBRARY_PATH=/usr/local/lib:\$LD_LIBRARY_PATH
          ${test_cmd}
CI_EOF
    fi

    if [ $with_wheel -eq 1 ]; then
        # pip packaging: pyproject + scikit-build-core + a CMake build that
        # consumes mirror_bridge via find_package/FetchContent. The CMake
        # path needs an explicit binding TU (auto-discovery is a CLI
        # feature), so one is scaffolded alongside.
        mkdir -p "$project_name/bindings"
        cat > "$project_name/bindings/${module_name}_binding.cpp" << BINDING_EOF
#include "mirror_bridge.hpp"
#include "greeter.hpp"

MIRROR_BRIDGE_MODULE(${module_name},
    mirror_bridge::bind_class<Greeter>(m, "Greeter");
)
BINDING_EOF

        cat > "$project_name/CMakeLists.txt" << CMAKE_EOF
cmake_minimum_required(VERSION 3.20)
project(${module_name} CXX)

# Prefer an installed mirror_bridge; fall back to fetching it.
# (Override the fetch with -DFETCHCONTENT_SOURCE_DIR_MIRROR_BRIDGE=/path)
find_package(mirror_bridge QUIET)
if(NOT mirror_bridge_FOUND)
    include(FetchContent)
    FetchContent_Declare(mirror_bridge
        GIT_REPOSITORY https://github.com/FranciscoThiesen/mirror_bridge
        GIT_TAG main
    )
    FetchContent_MakeAvailable(mirror_bridge)
endif()

mirror_bridge_python_module(${module_name}
    bindings/${module_name}_binding.cpp
    INCLUDE_DIRS \${CMAKE_CURRENT_SOURCE_DIR}/src
)

install(TARGETS ${module_name} LIBRARY DESTINATION .)
CMAKE_EOF

        cat > "$project_name/pyproject.toml" << PYPROJECT_EOF
[build-system]
requires = ["scikit-build-core>=0.10"]
build-backend = "scikit_build_core.build"

[project]
name = "${module_name}"
version = "0.1.0"
description = "C++ bindings generated by mirror_bridge (C++26 reflection)"
requires-python = ">=3.9"

[tool.scikit-build]
cmake.version = ">=3.20"
# A C++26 reflection compiler is required. In an environment where plain
# 'c++' isn't one, point CMake at it, e.g.:
#   CMAKE_ARGS="-DCMAKE_CXX_COMPILER=clang++" pip wheel .
PYPROJECT_EOF

        if [ $with_ci -eq 1 ]; then
            cat > "$project_name/.github/workflows/wheels.yml" << WHEELS_EOF
name: Wheels

on: [push, workflow_dispatch]

# Builds linux wheels inside the mirror_bridge reflection container.
# (manylinux images with a reflection compiler are not yet published, so
# these wheels target compatible linux hosts rather than PyPI's manylinux
# tag — see the mirror_bridge ROADMAP.)
jobs:
  linux-wheel:
    runs-on: ubuntu-latest
    container:
      image: ghcr.io/franciscothiesen/mirror_bridge:latest
    steps:
      - uses: actions/checkout@v4
      - name: Build wheel
        run: |
          python3 -m pip install --upgrade pip build
          CMAKE_ARGS="-DCMAKE_CXX_COMPILER=clang++" python3 -m build --wheel
      - name: Smoke test
        run: |
          export LD_LIBRARY_PATH=/usr/local/lib:\$LD_LIBRARY_PATH
          python3 -m pip install dist/*.whl
          python3 -c "import ${module_name}; g = ${module_name}.Greeter(); assert g.greet() == 'Hello, world!'"
      - uses: actions/upload-artifact@v4
        with:
          name: wheels
          path: dist/*.whl
WHEELS_EOF
        fi
    fi

    echo -e "${GREEN}✓ Created:${NC}"
    find "$project_name" -type f | sed 's/^/    /'
    echo ""
    echo -e "${YELLOW}Next steps:${NC}"
    echo "  cd $project_name"
    echo "  mirror_bridge generate src/ --module ${module_name} --lang ${gen_lang}"
    echo "  ${test_cmd}"
    if [ $with_wheel -eq 1 ]; then
        echo ""
        echo -e "${YELLOW}Wheel build:${NC}"
        echo "  CMAKE_ARGS=\"-DCMAKE_CXX_COMPILER=clang++\" pip wheel . -w dist/"
    fi
}

# Command: version
cmd_version() {
    echo "Mirror Bridge v$VERSION"
    echo "C++26 Reflection-based binding generator"
    echo ""
    echo "Supported languages: Python, Lua, JavaScript"
    echo "Supported compilers: Bloomberg clang-p2996, stock GCC 16+"
    echo "Selected compiler: $CXX_BIN (override with MB_CXX)"
}

# Main entry point
main() {
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi

    local command="$1"
    shift

    case "$command" in
        generate) cmd_generate "$@" ;;
        pch) cmd_pch "$@" ;;
        build) cmd_build "$@" ;;
        config) cmd_config "$@" ;;
        diff) cmd_diff "$@" ;;
        watch) cmd_watch "$@" ;;
        # Invoked via bash so the doctor script works even when the
        # executable bit was lost (e.g. mounted from a pip install).
        doctor) exec bash "$PROJECT_ROOT/mirror_bridge_doctor" "$@" ;;
        init) cmd_init "$@" ;;
        version|--version|-v) cmd_version ;;
        help|--help|-h) show_help ;;
        *)
            echo -e "${RED}Error: Unknown command '$command'${NC}"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

main "$@"
