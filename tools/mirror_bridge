#!/bin/bash
# Mirror Bridge - Unified CLI Tool
# Generates C++ bindings for Python, Lua, and JavaScript using C++26 reflection
#
# Usage: mirror_bridge <command> [options]
#
# Commands:
#   generate    Auto-discover and compile bindings from C++ headers
#   pch         Build precompiled header for faster compilation
#   build       Compile a manually-written binding file
#   config      Generate bindings from a configuration file
#   diff        Show binding surface changes since last build
#   watch       Watch headers and auto-recompile bindings on change
#   doctor      Diagnose environment and setup issues
#   init        Initialize a new Mirror Bridge project
#   version     Show version information

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Version
VERSION="0.3.0"

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Default configuration
OUTPUT_DIR="build"
VERBOSE=0
KEEP_GENERATED=0
FORCE_REBUILD=0
USE_PCH=""
PCH_PATH=""
LANG="python"
RELEASE_GIL=0
GEN_STUBS=0
NO_TEMPLATES=0
TEMPLATE_CAP=64
INSTANTIATE=()

# Reflection compiler detection. clang-p2996 is preferred when present;
# stock GCC 16+ with -freflection works as well (probed with a syntax-only
# compile since plain distro g++ predates reflection). Override with
# $MB_CXX when you need a specific binary.
if [ -n "${MB_CXX:-}" ]; then
    CXX_BIN="$MB_CXX"
elif command -v clang++ >/dev/null 2>&1 && clang++ --version 2>&1 | grep -qi "reflection\|p2996\|bloomberg"; then
    CXX_BIN="clang++"
elif command -v g++ >/dev/null 2>&1 && g++ -std=c++26 -freflection -x c++ -fsyntax-only /dev/null >/dev/null 2>&1; then
    CXX_BIN="g++"
elif command -v clang++ >/dev/null 2>&1; then
    CXX_BIN="clang++"
else
    CXX_BIN="g++"
fi

case "$CXX_BIN" in
    *clang*) CXX_REFLECT_FLAGS="-std=c++2c -freflection -freflection-latest -stdlib=libc++" ;;
    *)       CXX_REFLECT_FLAGS="-std=c++26 -freflection" ;;
esac

# JSON output support (--json on generate/diff/doctor). Contract: in JSON
# mode stdout carries exactly one JSON object and all human-readable
# progress goes to stderr, so scripts and AI agents can parse results
# reliably. Commands that support it open fd 3 on the real stdout and
# write the final object there.
JSON_MODE=0

json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# Emit a JSON error object (when in JSON mode) and exit non-zero.
# $1 = stage, $2 = reason, $3 = suggestion (optional)
json_fail() {
    if [ $JSON_MODE -eq 1 ]; then
        printf '{"status":"error","stage":"%s","reason":"%s","suggestion":"%s","docs":"https://github.com/FranciscoThiesen/mirror_bridge/blob/main/docs/reference/errors.md"}\n' \
            "$(json_escape "$1")" "$(json_escape "$2")" "$(json_escape "${3:-}")" >&3
    fi
    exit 1
}

# Map a failed compile log to an actionable one-line suggestion so callers
# (humans or agents) don't have to dig through raw compiler output.
suggest_fix() {
    local log="$1"
    if echo "$log" | grep -q "cannot convert"; then
        echo "A member type has no converter. Mark it [[=exclude{}]] or add a custom converter. See docs/reference/type-conversion.md"
    elif echo "$log" | grep -qE "'meta' file not found|freflection"; then
        echo "Compiler lacks C++26 reflection support. Run inside the mirror_bridge container (./start_dev_container.sh)"
    elif echo "$log" | grep -q "Eigen"; then
        echo "Eigen headers not found. Install libeigen3-dev or pass -I /path/to/eigen3"
    elif echo "$log" | grep -q "Python.h"; then
        echo "Python dev headers missing. Install python3-dev"
    elif echo "$log" | grep -q "lua.h"; then
        echo "Lua dev headers missing. Install liblua5.4-dev"
    elif echo "$log" | grep -q "node_api.h"; then
        echo "Node.js N-API headers missing. Headers normally ship with the Node.js installation"
    else
        echo "Re-run with --verbose for the full compiler output"
    fi
}

