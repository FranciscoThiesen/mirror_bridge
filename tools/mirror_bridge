# Discover classes in source directory.
#
# Handles nested classes correctly by tracking C++ brace depth and class scope:
# a class declared inside another class is reported as `Outer::Inner` (scopes
# joined with ::), so it can be referenced from binding code without needing
# the original class body. Namespaces are NOT joined — they're handled by the
# `using namespace` directives emitted elsewhere.
discover_classes() {
    local src_dir="$1"
    local -n classes_ref=$2
    local -n headers_ref=$3

    local header_files
    header_files=$(find "$src_dir" -type f \( -name "*.hpp" -o -name "*.h" \) | sort)

    if [ -z "$header_files" ]; then
        echo -e "${RED}Error: No header files found in $src_dir${NC}"
        exit 1
    fi

    # Python parser that understands nested classes. Emits one line per class:
    #   QUALIFIED_NAME\tLINE_NUMBER_OF_DECLARATION
    # Line numbers let the caller check the preceding line for MIRROR_BRIDGE_SKIP.
    #
    # Classes declared inside other classes are reported as Outer::Inner;
    # namespace scope is NOT joined (the `using namespace ...` emission elsewhere
    # handles that).
    local parser_script
    parser_script=$(cat <<'PYSCRIPT'
import re, sys

path = sys.argv[1]
try:
    with open(path, encoding='utf-8', errors='ignore') as f:
        raw = f.read()
except Exception:
    sys.exit(0)

# Strip comments and string/char literals while preserving line numbers so
# error messages and MIRROR_BRIDGE_SKIP lookups remain accurate.
def keep_newlines(m):
    return '\n' * m.group(0).count('\n')

content = re.sub(r'/\*.*?\*/', keep_newlines, raw, flags=re.DOTALL)
content = re.sub(r'//[^\n]*', '', content)
content = re.sub(r'"(?:[^"\\]|\\.)*"', '""', content)
content = re.sub(r"'(?:[^'\\]|\\.)*'", "''", content)

# Tokenize to {, }, ;, class NAME, struct NAME, and 'template' (for
# template-parameter skipping). This is much simpler than hand-walking chars.
token_re = re.compile(
    r'\b(class|struct)\b\s+([A-Za-z_]\w*)'  # 1,2: class/struct keyword + name
    r'|\btemplate\b'                        # 3: template keyword
    r'|([{};])'                             # 4: punctuation we care about
)

tokens = []
for m in token_re.finditer(content):
    line_no = content.count('\n', 0, m.start()) + 1
    if m.group(1):   # class/struct declaration
        tokens.append(('decl', m.group(2), line_no, m.end()))
    elif m.group(0) == 'template':
        tokens.append(('template', None, line_no, m.end()))
    else:            # {, }, ;
        tokens.append((m.group(3), None, line_no, m.end()))

# Walk tokens. A 'decl' followed (eventually) by '{' at depth D pushes the name
# onto the class stack at depth D. A 'decl' followed by ';' is a forward
# declaration and is dropped. 'template' makes the *next* token sequence skip
# a matching <...> block — we handle that by scanning the raw text between the
# template token and its balanced '>'.
depth = 0
class_stack = []     # list of (name, opened_at_depth)
pending = None       # (name, line_no) awaiting a '{'
skip_until_pos = 0   # positions up to here were eaten by a template<...>
skip_next_decl = False  # True after a template<...> block — next decl is a template
results = []

def skip_template_params(start):
    # Find the matching '>' for a '<' that follows 'template'.
    lt = content.find('<', start)
    if lt < 0:
        return start
    d = 1
    i = lt + 1
    while i < len(content) and d > 0:
        if content[i] == '<':
            d += 1
        elif content[i] == '>':
            d -= 1
        i += 1
    return i

for kind, name, line_no, end_pos in tokens:
    if end_pos <= skip_until_pos:
        continue
    if kind == 'template':
        skip_until_pos = skip_template_params(end_pos)
        skip_next_decl = True
        continue
    if kind == 'decl':
        if skip_next_decl:
            # Template class — can't be bound directly (needs instantiation).
            # Still push a placeholder so the brace matching stays consistent;
            # we just never emit it.
            pending = ('__mb_template__', line_no)
            skip_next_decl = False
        else:
            pending = (name, line_no)
    elif kind == '{':
        if pending is not None:
            class_stack.append((pending[0], depth))
            if pending[0] != '__mb_template__' and \
               not any(n == '__mb_template__' for n, _ in class_stack[:-1]):
                qual = '::'.join(n for n, _ in class_stack)
                results.append((qual, pending[1]))
            pending = None
        depth += 1
    elif kind == '}':
        depth -= 1
        while class_stack and class_stack[-1][1] >= depth:
            class_stack.pop()
    elif kind == ';':
        pending = None  # forward declaration — discard
        skip_next_decl = False

for name, lineno in results:
    print(f"{name}\t{lineno}")
PYSCRIPT
    )

    while IFS= read -r header_file; do
        local rel_path
        rel_path=$(realpath --relative-to="$src_dir" "$header_file")

        # If user passed -I directories, prefer a path relative to the
        # broadest include root (so #include matches what internal headers
        # use, e.g. "open3d/geometry/Foo.h" rather than just "Foo.h").
        local abs_header
        abs_header=$(realpath "$header_file" 2>/dev/null || echo "$header_file")
        for inc in "${_INCLUDE_DIRS[@]:-}"; do
            [ -z "$inc" ] && continue
            local abs_inc
            abs_inc=$(realpath "$inc" 2>/dev/null || echo "$inc")
            if [[ "$abs_header" == "$abs_inc"/* ]]; then
                local candidate="${abs_header#$abs_inc/}"
                # Prefer the path with more directory components (broader root)
                if [ -z "$rel_path_from_inc" ] || [ "${#candidate}" -gt "${#rel_path_from_inc}" ]; then
                    rel_path_from_inc="$candidate"
                fi
            fi
        done
        if [ -n "${rel_path_from_inc:-}" ]; then
            rel_path="$rel_path_from_inc"
            unset rel_path_from_inc
        fi

        # Skip files marked with MIRROR_BRIDGE_SKIP_FILE
        if grep -q "MIRROR_BRIDGE_SKIP_FILE" "$header_file" 2>/dev/null; then
            [ $VERBOSE -eq 1 ] && echo -e "${BLUE}  Skipping file: $rel_path${NC}"
            continue
        fi

        # Run the Python parser on this header.
        while IFS=$'\t' read -r class_name line_num; do
            [ -z "$class_name" ] && continue

            # Honor MIRROR_BRIDGE_SKIP annotation on the line before the declaration.
            if [ -n "$line_num" ] && [ "$line_num" -gt 1 ]; then
                local prev_line=$((line_num - 1))
                if sed -n "${prev_line}p" "$header_file" | grep -q "MIRROR_BRIDGE_SKIP"; then
                    [ $VERBOSE -eq 1 ] && echo -e "${BLUE}  Skipping: $class_name (marked SKIP)${NC}"
                    continue
                fi
            fi

            classes_ref+=("$class_name")
            headers_ref+=("$rel_path")
            echo -e "  ${GREEN}✓${NC} Found: $class_name in $rel_path"
        done < <(python3 -c "$parser_script" "$header_file" 2>/dev/null)
    done <<< "$header_files"
}

# Generate binding file for a specific language
generate_binding_file() {
    local lang="$1"
    local module_name="$2"
    local output_file="$3"
    local -n classes=$4
    local -n headers=$5
    local src_dir="$6"

    local include_header
    local module_macro
    local bind_func

    case "$lang" in
        python)
            include_header="mirror_bridge.hpp"
            module_macro="MIRROR_BRIDGE_MODULE"
            bind_func="mirror_bridge::bind_class"
            ;;
        lua)
            include_header="lua/mirror_bridge_lua.hpp"
            module_macro="MIRROR_BRIDGE_LUA_MODULE"
            bind_func="mirror_bridge::lua::bind_class"
            ;;
        js|javascript)
            include_header="javascript/mirror_bridge_javascript.hpp"
            module_macro="MIRROR_BRIDGE_JS_MODULE"
            bind_func="mirror_bridge::javascript::bind_class"
            ;;
    esac

    cat > "$output_file" << EOF
// Auto-generated by mirror_bridge
// Source: $src_dir
// Language: $lang
// Generated: $(date)

#include "$include_header"
EOF

    # Add unique header includes
    declare -A included
    for header in "${headers[@]}"; do
        if [ -z "${included["$header"]}" ]; then
            echo "#include \"$header\"" >> "$output_file"
            included["$header"]=1
        fi
    done

    echo "" >> "$output_file"

    # Detect namespaces and emit using directives, using a Python helper that
    # tracks brace depth properly. Collect all files in one invocation.
    declare -A ns_seen
    local ns_script
    ns_script=$(cat <<'PYSCRIPT'
import re, sys
seen = set()
for path in sys.argv[1:]:
    try:
        with open(path, encoding='utf-8', errors='ignore') as f:
            text = f.read()
    except Exception:
        continue
    text = re.sub(r'//[^\n]*', '', text)
    text = re.sub(r'/\*.*?\*/', '', text, flags=re.DOTALL)
    depth = 0
    ns_stack = []
    i = 0
    while i < len(text):
        ch = text[i]
        if ch == '{':
            depth += 1
        elif ch == '}':
            depth -= 1
            while ns_stack and ns_stack[-1][1] >= depth:
                ns_stack.pop()
        elif ch == 'n':
            m = re.match(r'namespace\s+([a-zA-Z_][a-zA-Z0-9_:]*)\s*\{', text[i:])
            if m:
                ns_name = m.group(1)
                if ns_name != 'std':
                    ns_stack.append((ns_name, depth))
                    fqn = '::'.join(n for n, _ in ns_stack)
                    if fqn and fqn not in seen:
                        seen.add(fqn)
                        print(fqn)
                depth += 1
                i += m.end()
                continue
        i += 1
PYSCRIPT
    )

    local -a ns_paths=()
    for header in "${headers[@]}"; do
        # Header may be relative to src_dir OR to an include root.
        # Try each form.
        local full_path=""
        if [ -f "$src_dir/$header" ]; then
            full_path="$src_dir/$header"
        elif [ -f "$header" ]; then
            full_path="$header"
        else
            # Try each -I include dir
            for inc in "${_INCLUDE_DIRS[@]:-}"; do
                if [ -n "$inc" ] && [ -f "$inc/$header" ]; then
                    full_path="$inc/$header"; break
                fi
            done
        fi
        [ -n "$full_path" ] && ns_paths+=("$full_path")
    done

    if [ ${#ns_paths[@]} -gt 0 ]; then
        while IFS= read -r fqn; do
            if [ -n "$fqn" ] && [ -z "${ns_seen["$fqn"]}" ]; then
                echo "using namespace $fqn;" >> "$output_file"
                ns_seen["$fqn"]=1
            fi
        done < <(python3 -c "$ns_script" "${ns_paths[@]}" 2>/dev/null)
    fi

    echo "" >> "$output_file"

    # Generate module.
    # Python/Lua/JS class names are the simple name (last segment after ::),
    # since they're flat identifiers in the target language. The C++ template
    # argument keeps the fully-qualified scope.
    echo "$module_macro($module_name," >> "$output_file"
    for class_name in "${classes[@]}"; do
        local simple_name="${class_name##*::}"
        if [ "$lang" = "js" ] || [ "$lang" = "javascript" ]; then
            echo "    $bind_func<$class_name>(env, m, \"$simple_name\");" >> "$output_file"
        elif [ "$lang" = "lua" ]; then
            echo "    $bind_func<$class_name>(L, \"$simple_name\");" >> "$output_file"
        else
            echo "    $bind_func<$class_name>(m, \"$simple_name\");" >> "$output_file"
        fi
    done

    echo ")" >> "$output_file"
}

# Compile binding for a specific language
compile_binding() {
    local lang="$1"
    local module_name="$2"
    local binding_file="$3"
    local output_dir="$4"
    local src_dir="$5"
    local pch_path="$6"
    shift 6
    local extra_includes=("$@")

    local output_ext
    local compile_flags
    local link_flags=""

    case "$lang" in
        python)
            output_ext=".so"
            compile_flags="$(python3-config --includes)"
            link_flags="$(python3-config --ldflags 2>/dev/null || echo "")"
            ;;
        lua)
            output_ext=".so"
            compile_flags="-I/usr/include/lua5.4"
            link_flags="-llua5.4"
            ;;
        js|javascript)
            output_ext=".node"
            compile_flags="-I/usr/include/node"
            ;;
    esac

    local output_file="$output_dir/${module_name}${output_ext}"

    local cmd="$CXX_BIN $CXX_REFLECT_FLAGS \
        -I. -I$src_dir -I$PROJECT_ROOT \
        -fPIC -shared -O3 -DNDEBUG \
        -Wno-deprecated-declarations"

    # Add user-supplied -I directories
    for inc in "${extra_includes[@]}"; do
        [ -n "$inc" ] && cmd="$cmd -I$inc"
    done

    # Auto-detect Eigen and add include path
    if grep -rq "Eigen/" "$src_dir" 2>/dev/null; then
        for eigen_path in /usr/include/eigen3 /usr/local/include/eigen3 /opt/homebrew/include/eigen3; do
            if [ -d "$eigen_path" ]; then
                cmd="$cmd -I$eigen_path"
                [ $VERBOSE -eq 1 ] && echo -e "${BLUE}  Auto-detected Eigen at $eigen_path${NC}"
                break
            fi
        done
    fi

    if [ -n "$pch_path" ] && [ -f "$pch_path" ]; then
        case "$CXX_BIN" in
            # -include-pch is clang-only; GCC picks up a .gch automatically
            # when it sits next to the included header, so skip the flag.
            *clang*) cmd="$cmd -include-pch $pch_path" ;;
        esac
    fi

    cmd="$cmd $compile_flags $binding_file -o $output_file $link_flags"

    # Capture the full compiler output so failures can be reported with
    # context (and machine-readably in --json mode via LAST_COMPILE_LOG).
    # Track the exit code explicitly: checking only for the output file
    # would let a stale .so from a previous run mask a failed compile.
    LAST_COMPILE_LOG=""
    local compile_rc=0
    if [ $VERBOSE -eq 1 ]; then
        echo -e "${BLUE}$cmd${NC}"
        LAST_COMPILE_LOG=$(eval "$cmd" 2>&1) || compile_rc=$?
        [ -n "$LAST_COMPILE_LOG" ] && echo "$LAST_COMPILE_LOG"
    else
        LAST_COMPILE_LOG=$(eval "$cmd" 2>&1) || compile_rc=$?
        echo "$LAST_COMPILE_LOG" | grep -E "(error|Error)" || true
    fi

    if [ $compile_rc -eq 0 ] && [ -f "$output_file" ]; then
        echo -e "${GREEN}✓ Built: $output_file${NC}"
        LAST_OUTPUT_FILE="$output_file"
        return 0
    else
        echo -e "${RED}✗ Failed to build: $output_file${NC}"
        return 1
    fi
}

# Command: generate
cmd_generate() {
    local src_dir=""
    local module_name=""
    local include_dirs=()

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help) show_generate_help; exit 0 ;;
            --module) module_name="$2"; shift 2 ;;
            --lang) LANG="$2"; shift 2 ;;
            -o|--output) OUTPUT_DIR="$2"; shift 2 ;;
            -k|--keep-generated) KEEP_GENERATED=1; shift ;;
            -v|--verbose) VERBOSE=1; shift ;;
            -f|--force) FORCE_REBUILD=1; shift ;;
            --json) JSON_MODE=1; shift ;;
            -I) include_dirs+=("$2"); shift 2 ;;
            --pch)
                USE_PCH="1"
                if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
                    PCH_PATH="$2"; shift 2
                else
                    PCH_PATH="auto"; shift
                fi
                ;;
            -*)
                echo -e "${RED}Error: Unknown option $1${NC}"
                show_generate_help
                exit 1
                ;;
            *)
                if [ -z "$src_dir" ]; then
                    src_dir="$1"
                fi
                shift
                ;;
        esac
    done

    # In JSON mode stdout must carry only the final JSON object: park the
    # real stdout on fd 3 and route all progress chatter to stderr.
    if [ $JSON_MODE -eq 1 ]; then
        exec 3>&1 1>&2
    fi

    # Validate
    [ -z "$src_dir" ] && { echo -e "${RED}Error: No source directory specified${NC}"; show_generate_help; json_fail "args" "No source directory specified"; }
    [ -z "$module_name" ] && { echo -e "${RED}Error: No module name specified (use --module)${NC}"; show_generate_help; json_fail "args" "No module name specified (use --module)"; }
    [ ! -d "$src_dir" ] && { echo -e "${RED}Error: Directory not found: $src_dir${NC}"; json_fail "args" "Directory not found: $src_dir"; }

    src_dir=$(realpath "$src_dir")
    OUTPUT_DIR=$(realpath "$OUTPUT_DIR" 2>/dev/null || echo "$OUTPUT_DIR")
    mkdir -p "$OUTPUT_DIR"

    echo -e "${CYAN}Mirror Bridge - Generate Bindings${NC}"
    echo -e "${CYAN}==================================${NC}"
    echo ""
    echo -e "Source:  ${YELLOW}$src_dir${NC}"
    echo -e "Module:  ${YELLOW}$module_name${NC}"
    echo -e "Lang:    ${YELLOW}$LANG${NC}"
    echo ""

    # Discover classes (pass include dirs so headers get proper paths)
    echo -e "${YELLOW}Scanning for classes...${NC}"
    declare -a CLASSES
    declare -a HEADERS
    # Make include dirs visible to discover_classes (bash arrays are process-local)
    _INCLUDE_DIRS=("${include_dirs[@]}")
    discover_classes "$src_dir" CLASSES HEADERS

    if [ ${#CLASSES[@]} -eq 0 ]; then
        echo -e "${RED}Error: No classes found in $src_dir${NC}"
        json_fail "discover" "No classes found in $src_dir" \
            "Check that headers contain struct/class definitions and are not all marked MIRROR_BRIDGE_SKIP_FILE"
    fi

    echo ""
    echo -e "${GREEN}Discovered ${#CLASSES[@]} classes${NC}"
    echo ""

    # Auto-detect PCH if requested
    if [ "$PCH_PATH" = "auto" ]; then
        for pch_candidate in \
            "$OUTPUT_DIR/mirror_bridge_pch.hpp.gch" \
            "build/mirror_bridge_pch.hpp.gch" \
            "mirror_bridge_pch.hpp.gch"
        do
            if [ -f "$pch_candidate" ]; then
                PCH_PATH="$pch_candidate"
                echo -e "${GREEN}✓ Found PCH: $PCH_PATH${NC}"
                break
            fi
        done

        if [ "$PCH_PATH" = "auto" ]; then
            echo -e "${YELLOW}Note: No PCH found. Consider running 'mirror_bridge pch' for faster builds.${NC}"
            PCH_PATH=""
        fi
    fi

    # Determine languages to generate
    local languages=()
    case "$LANG" in
        all) languages=("python" "lua" "js") ;;
        python|lua|js|javascript) languages=("$LANG") ;;
        *) echo -e "${RED}Error: Unknown language: $LANG${NC}"; json_fail "args" "Unknown language: $LANG" "Valid values: python, lua, js, all" ;;
    esac

    # Generate and compile for each language. A failed language no longer
    # aborts the whole run (previously set -e killed the script on the first
    # failure): remaining languages still get built, failures are collected,
    # and the exit code reflects the overall result.
    local -a built_outputs=()
    local -a failed_langs=()
    local errors_json=""
    for lang in "${languages[@]}"; do
        echo -e "${YELLOW}Generating $lang bindings...${NC}"

        local binding_file="$OUTPUT_DIR/${module_name}_${lang}_binding.cpp"
        generate_binding_file "$lang" "$module_name" "$binding_file" CLASSES HEADERS "$src_dir"

        echo -e "${YELLOW}Compiling $lang module...${NC}"
        if compile_binding "$lang" "$module_name" "$binding_file" "$OUTPUT_DIR" "$src_dir" "$PCH_PATH" "${include_dirs[@]:-}"; then
            built_outputs+=("$LAST_OUTPUT_FILE")
        else
            failed_langs+=("$lang")
            local first_err
            first_err=$(echo "$LAST_COMPILE_LOG" | grep -m1 -E "error" || echo "compilation failed")
            errors_json+="{\"lang\":\"$(json_escape "$lang")\",\"reason\":\"$(json_escape "$first_err")\",\"suggestion\":\"$(json_escape "$(suggest_fix "$LAST_COMPILE_LOG")")\"},"
        fi

        if [ $KEEP_GENERATED -eq 0 ]; then
            rm -f "$binding_file"
        fi
    done

    if [ $JSON_MODE -eq 1 ]; then
        local classes_json="" langs_json="" outputs_json="" i
        for i in "${!CLASSES[@]}"; do
            classes_json+="{\"name\":\"$(json_escape "${CLASSES[$i]}")\",\"header\":\"$(json_escape "${HEADERS[$i]}")\"},"
        done
        for lang in "${languages[@]}"; do
            langs_json+="\"$(json_escape "$lang")\","
        done
        for out in "${built_outputs[@]}"; do
            outputs_json+="\"$(json_escape "$out")\","
        done
        local status="ok"
        [ ${#failed_langs[@]} -gt 0 ] && status="error"
        printf '{"status":"%s","module":"%s","languages":[%s],"classes":[%s],"outputs":[%s],"errors":[%s]}\n' \
            "$status" "$(json_escape "$module_name")" "${langs_json%,}" \
            "${classes_json%,}" "${outputs_json%,}" "${errors_json%,}" >&3
    fi

    echo ""
    if [ ${#failed_langs[@]} -gt 0 ]; then
        echo -e "${RED}✗ Failed languages: ${failed_langs[*]}${NC}"
        exit 1
    fi
    echo -e "${GREEN}✓ Successfully built bindings for: ${languages[*]}${NC}"
}

# Command: pch
cmd_pch() {
    local output_dir=""
    local build_type=""
    local pch_lang="python"

    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help) show_pch_help; exit 0 ;;
            --output) output_dir="$2"; shift 2 ;;
            --type) build_type="$2"; shift 2 ;;
            --lang) pch_lang="$2"; shift 2 ;;
            -v|--verbose) VERBOSE=1; shift ;;
            *)
                echo -e "${RED}Error: Unknown option $1${NC}"
                show_pch_help
                exit 1
                ;;
        esac
    done

    [ -z "$output_dir" ] && { echo -e "${RED}Error: --output required${NC}"; show_pch_help; exit 1; }
    [ -z "$build_type" ] && { echo -e "${RED}Error: --type required (release or debug)${NC}"; show_pch_help; exit 1; }

    mkdir -p "$output_dir"

    local opt_flags
    case "$build_type" in
        release) opt_flags="-O3 -DNDEBUG" ;;
        debug) opt_flags="-O0 -g" ;;
        *) echo -e "${RED}Error: Unknown build type: $build_type${NC}"; exit 1 ;;
    esac

    local pch_file="$PROJECT_ROOT/mirror_bridge_pch.hpp"
    local output_file="$output_dir/mirror_bridge_pch.hpp.gch"

    echo -e "${CYAN}Building Precompiled Header${NC}"
    echo -e "Type: ${YELLOW}$build_type${NC}"
    echo -e "Output: ${YELLOW}$output_file${NC}"
    echo ""

    local cmd="$CXX_BIN $CXX_REFLECT_FLAGS \
        -fPIC \
        $(python3-config --includes) \
        $opt_flags \
        -x c++-header $pch_file \
        -o $output_file"

    if [ $VERBOSE -eq 1 ]; then
        echo -e "${BLUE}$cmd${NC}"
    fi

    echo -e "${YELLOW}Compiling PCH (this takes ~600ms)...${NC}"
    eval "$cmd" 2>&1 | grep -v "mixture of designated" || true

    if [ -f "$output_file" ]; then
        echo -e "${GREEN}✓ PCH created: $output_file${NC}"
    else
        echo -e "${RED}✗ Failed to create PCH${NC}"
        exit 1
    fi
}

# Command: build
cmd_build() {
    local binding_file=""
    local include_dirs=()

    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                echo "Usage: mirror_bridge build <binding.cpp> [options]"
                exit 0
                ;;
            -o|--output) OUTPUT_DIR="$2"; shift 2 ;;
            -I) include_dirs+=("-I$2"); shift 2 ;;
            -v|--verbose) VERBOSE=1; shift ;;
            --pch)
                if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
                    PCH_PATH="$2"; shift 2
                else
                    PCH_PATH="auto"; shift
                fi
                ;;
            --lang) LANG="$2"; shift 2 ;;
            -*)
                echo -e "${RED}Error: Unknown option $1${NC}"
                exit 1
                ;;
            *)
                binding_file="$1"
                shift
                ;;
        esac
    done

    [ -z "$binding_file" ] && { echo -e "${RED}Error: No binding file specified${NC}"; exit 1; }
    [ ! -f "$binding_file" ] && { echo -e "${RED}Error: File not found: $binding_file${NC}"; exit 1; }

    mkdir -p "$OUTPUT_DIR"

    # Extract module name from filename
    local module_name
    module_name=$(basename "$binding_file" | sed 's/_binding\.cpp$//' | sed 's/\.cpp$//')

    echo -e "${CYAN}Building: $binding_file${NC}"
    compile_binding "$LANG" "$module_name" "$binding_file" "$OUTPUT_DIR" "." "$PCH_PATH"
}

# Command: config
cmd_config() {
    local config_file=""

    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                echo "Usage: mirror_bridge config <config.mirror> [options]"
                exit 0
                ;;
            -o|--output) OUTPUT_DIR="$2"; shift 2 ;;
            -v|--verbose) VERBOSE=1; shift ;;
            -k|--keep-generated) KEEP_GENERATED=1; shift ;;
            --pch)
                if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
                    PCH_PATH="$2"; shift 2
                else
                    PCH_PATH="auto"; shift
                fi
                ;;
            -*)
                echo -e "${RED}Error: Unknown option $1${NC}"
                exit 1
                ;;
            *)
                config_file="$1"
                shift
                ;;
        esac
    done

    [ -z "$config_file" ] && { echo -e "${RED}Error: No config file specified${NC}"; exit 1; }
    [ ! -f "$config_file" ] && { echo -e "${RED}Error: Config file not found: $config_file${NC}"; exit 1; }

    # Use existing mirror_bridge_generate script
    local generate_script="$PROJECT_ROOT/mirror_bridge_generate"
    if [ -x "$generate_script" ]; then
        local args=("$config_file" "-o" "$OUTPUT_DIR")
        [ $VERBOSE -eq 1 ] && args+=("-v")
        [ $KEEP_GENERATED -eq 1 ] && args+=("-k")
        "$generate_script" "${args[@]}"
    else
        echo -e "${RED}Error: Config file generation not available${NC}"
        exit 1
    fi
}

# Command: diff - Show binding surface changes between builds
# Compares current class signatures with the last recorded snapshot
cmd_diff() {
    local src_dir=""
    local update_snapshot=0
    local check_mode=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --help|-h) show_diff_help; exit 0 ;;
            --output|-o) OUTPUT_DIR="$2"; shift 2 ;;
            --update|-u) update_snapshot=1; shift ;;
            --check) check_mode=1; shift ;;
            --json) JSON_MODE=1; shift ;;
            *) src_dir="$1"; shift ;;
        esac
    done

    if [ $JSON_MODE -eq 1 ]; then
        exec 3>&1 1>&2
    fi

    [ -z "$src_dir" ] && { echo -e "${RED}Error: Source directory required${NC}"; json_fail "args" "Source directory required"; }

    local snapshot_dir="$OUTPUT_DIR/.mirror_bridge"
    local snapshot_file="$snapshot_dir/binding_snapshot.txt"

    local current_sig
    current_sig=$(scan_binding_signatures "$src_dir")

    if [ ! -f "$snapshot_file" ]; then
        # In check mode a missing snapshot is an error, not a fresh start:
        # CI should compare against a committed snapshot, never silently
        # create one and pass.
        if [ $check_mode -eq 1 ]; then
            echo -e "${RED}Error: No snapshot found at $snapshot_file${NC}"
            echo -e "${YELLOW}Run 'mirror_bridge diff $src_dir --update' locally and commit the snapshot.${NC}"
            if [ $JSON_MODE -eq 1 ]; then
                printf '{"status":"error","changed":null,"reason":"no snapshot found","snapshot":"%s"}\n' \
                    "$(json_escape "$snapshot_file")" >&3
            fi
            exit 2
        fi
        echo -e "${YELLOW}No previous snapshot found. Creating initial snapshot.${NC}"
        mkdir -p "$snapshot_dir"
        printf '%s\n' "$current_sig" > "$snapshot_file"
        echo -e "${GREEN}Snapshot saved to $snapshot_file${NC}"
        if [ $JSON_MODE -eq 1 ]; then
            printf '{"status":"ok","changed":false,"snapshot_created":true}\n' >&3
        fi
        return 0
    fi

    local previous_sig
    previous_sig=$(cat "$snapshot_file")

    if [ "$current_sig" = "$previous_sig" ]; then
        echo -e "${GREEN}No binding surface changes detected.${NC}"
        if [ $JSON_MODE -eq 1 ]; then
            printf '{"status":"ok","changed":false}\n' >&3
        fi
        return 0
    fi

    echo -e "${CYAN}Binding Surface Changes:${NC}"
    echo "========================"

    diff <(printf '%s\n' "$previous_sig") <(printf '%s\n' "$current_sig") || true

    local added removed
    added=$(diff <(printf '%s\n' "$previous_sig") <(printf '%s\n' "$current_sig") | grep -c "^>" || true)
    removed=$(diff <(printf '%s\n' "$previous_sig") <(printf '%s\n' "$current_sig") | grep -c "^<" || true)

    echo ""
    echo -e "  ${GREEN}+ $added added${NC}  ${RED}- $removed removed${NC}"

    if [ $JSON_MODE -eq 1 ]; then
        printf '{"status":"ok","changed":true,"added":%s,"removed":%s}\n' "$added" "$removed" >&3
    fi

    # In check mode drift is a failure: exit non-zero so CI/agents catch
    # binding-surface changes that weren't snapshotted intentionally.
    if [ "$check_mode" -eq 1 ]; then
        echo -e "${RED}Binding surface drifted from snapshot (--check).${NC}"
        exit 1
    fi

    # Update snapshot: via flag, or interactively if terminal is attached
    if [ "$update_snapshot" -eq 1 ]; then
        printf '%s\n' "$current_sig" > "$snapshot_file"
        echo -e "${GREEN}Snapshot updated.${NC}"
    elif [ -t 0 ]; then
        echo ""
        read -p "Update snapshot? [y/N] " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            printf '%s\n' "$current_sig" > "$snapshot_file"
            echo -e "${GREEN}Snapshot updated.${NC}"
        fi
    else
        echo -e "${YELLOW}Run with --update to save new snapshot.${NC}"
    fi
}

# Scan headers to extract binding signatures (class names, members, methods)
scan_binding_signatures() {
    local src_dir="$1"

    # Find headers and sort for deterministic output across platforms
    find "$src_dir" -maxdepth 1 \( -name "*.hpp" -o -name "*.h" \) 2>/dev/null | sort | while read -r header; do
        [ -f "$header" ] || continue
        local basename
        basename=$(basename "$header")

        # Skip files marked with MIRROR_BRIDGE_SKIP
        grep -q "MIRROR_BRIDGE_SKIP" "$header" 2>/dev/null && continue

        printf '=== %s ===\n' "$basename"

        # Extract class/struct names
        grep -E "^(struct|class)\s+\w+" "$header" 2>/dev/null | while read -r line; do
            local class_name
            class_name=$(printf '%s' "$line" | grep -oE "(struct|class)\s+\w+" | awk '{print $2}')
            printf '  class: %s\n' "$class_name"
        done

        # Extract public data members
        grep -E "^\s+(int|double|float|bool|std::\w+|unsigned|long|short|char)\s+\w+" "$header" 2>/dev/null | \
            sed 's/^\s*/  member: /' | head -50

        # Extract method signatures (skip control flow, comments, preprocessor)
        grep -E "^\s+\w+.*\w+\(.*\)" "$header" 2>/dev/null | \
            grep -v "^\s*//" | grep -v "^\s*#" | grep -v "^\s*if\b" | \
            grep -v "^\s*for\b" | grep -v "^\s*while\b" | grep -v "^\s*return\b" | \
            sed 's/^\s*/  method: /' | head -50

        echo ""
    done
}

show_diff_help() {
    cat << EOF
${CYAN}mirror_bridge diff${NC} - Show binding surface changes

${YELLOW}Usage:${NC}
  mirror_bridge diff <src_dir> [--output <dir>]

Compares the current class definitions in <src_dir> against a stored
snapshot, showing added/removed members and methods. Useful for catching
accidental ABI breaks during development.

${YELLOW}Options:${NC}
  --output, -o    Build directory for storing snapshots (default: build)
  --update, -u    Update the snapshot without prompting (CI-friendly)
  --check         Exit 1 if the surface drifted, 2 if no snapshot exists.
                  Never modifies the snapshot. Use in CI to catch
                  unintentional binding-surface changes.
  --json          Emit one JSON result object on stdout (progress -> stderr)

${YELLOW}Example:${NC}
  mirror_bridge diff src/
  mirror_bridge diff src/ --update      # Non-interactive update
  mirror_bridge diff src/ --check       # CI gate: fail on drift
  mirror_bridge diff src/ --output build/
EOF
}

# Command: watch - Live reload during development
# Watches header files for changes and recompiles bindings automatically
cmd_watch() {
    local src_dir=""
    local module_name=""
    local interval=2

    while [ $# -gt 0 ]; do
        case "$1" in
            --help|-h) show_watch_help; exit 0 ;;
            --module|-m) module_name="$2"; shift 2 ;;
            --output|-o) OUTPUT_DIR="$2"; shift 2 ;;
            --lang|-l) LANG="$2"; shift 2 ;;
            --interval|-i) interval="$2"; shift 2 ;;
            --pch) USE_PCH="--pch"; shift ;;
            *) src_dir="$1"; shift ;;
        esac
    done

    [ -z "$src_dir" ] && { echo -e "${RED}Error: Source directory required${NC}"; exit 1; }
    [ -z "$module_name" ] && { echo -e "${RED}Error: Module name required (--module)${NC}"; exit 1; }

    echo -e "${CYAN}Mirror Bridge Watch Mode${NC}"
    echo -e "Watching ${BLUE}$src_dir${NC} for changes..."
    echo -e "Module: ${GREEN}$module_name${NC} | Language: ${GREEN}$LANG${NC} | Interval: ${interval}s"
    echo -e "Press Ctrl+C to stop."
    echo ""

    local checksum_file
    checksum_file=$(mktemp) || { echo -e "${RED}Error: failed to create temp file${NC}"; exit 1; }

    # Clean up temp files on exit (Ctrl+C, termination, or normal exit)
    trap 'rm -f "$checksum_file"; exit' INT TERM EXIT

    compute_header_checksums "$src_dir" > "$checksum_file"

    # Initial build
    echo -e "${YELLOW}[$(date +%H:%M:%S)]${NC} Initial build..."
    cmd_generate "$src_dir" --module "$module_name" --lang "$LANG" $USE_PCH 2>&1 && \
        echo -e "${GREEN}[$(date +%H:%M:%S)] Build successful${NC}" || \
        echo -e "${RED}[$(date +%H:%M:%S)] Build failed${NC}"

    # Watch loop
    while true; do
        sleep "$interval"

        local new_checksums
        new_checksums=$(mktemp) || continue
        compute_header_checksums "$src_dir" > "$new_checksums"

        if ! diff -q "$checksum_file" "$new_checksums" > /dev/null 2>&1; then
            local changed_files
            changed_files=$(diff "$checksum_file" "$new_checksums" | grep ">" | awk '{print $3}')
            echo ""
            echo -e "${YELLOW}[$(date +%H:%M:%S)]${NC} Changes detected:"
            for f in $changed_files; do
                echo -e "  ${BLUE}$f${NC}"
            done

            echo -e "${YELLOW}[$(date +%H:%M:%S)]${NC} Rebuilding..."
            cmd_generate "$src_dir" --module "$module_name" --lang "$LANG" $USE_PCH 2>&1 && \
                echo -e "${GREEN}[$(date +%H:%M:%S)] Build successful${NC}" || \
                echo -e "${RED}[$(date +%H:%M:%S)] Build failed${NC}"

            cp "$new_checksums" "$checksum_file"
        fi

        rm -f "$new_checksums"
    done

    rm -f "$checksum_file"
}

# Compute checksums of all header files in a directory
compute_header_checksums() {
    local dir="$1"
    find "$dir" -maxdepth 3 \( -name "*.hpp" -o -name "*.h" \) -exec md5sum {} \; 2>/dev/null | sort
}

show_watch_help() {
    cat << EOF
${CYAN}mirror_bridge watch${NC} - Live reload during development

${YELLOW}Usage:${NC}
  mirror_bridge watch <src_dir> --module <name> [options]

Watches C++ header files for changes and automatically recompiles
bindings when modifications are detected.

${YELLOW}Required:${NC}
  <src_dir>             Directory containing C++ headers
  --module, -m <name>   Name for the generated module

${YELLOW}Options:${NC}
  --lang, -l <lang>     Target language (python|lua|js|all) [default: python]
  --output, -o <dir>    Output directory [default: build]
  --interval, -i <sec>  Poll interval in seconds [default: 2]
  --pch                 Use precompiled header for faster builds

${YELLOW}Example:${NC}
  mirror_bridge watch src/ --module my_lib --lang python
  mirror_bridge watch src/ --module my_lib --lang all --pch --interval 1
EOF
}

# Command: version
cmd_version() {
    echo "Mirror Bridge v$VERSION"
    echo "C++26 Reflection-based binding generator"
    echo ""
    echo "Supported languages: Python, Lua, JavaScript"
    echo "Compiler required: Bloomberg clang-p2996"
}

# Main entry point
main() {
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi

    local command="$1"
    shift

    case "$command" in
        generate) cmd_generate "$@" ;;
        pch) cmd_pch "$@" ;;
        build) cmd_build "$@" ;;
        config) cmd_config "$@" ;;
        diff) cmd_diff "$@" ;;
        watch) cmd_watch "$@" ;;
        # Invoked via bash so the doctor script works even when the
        # executable bit was lost (e.g. mounted from a pip install).
        doctor) exec bash "$PROJECT_ROOT/mirror_bridge_doctor" "$@" ;;
        init) echo "Not yet implemented"; exit 1 ;;
        version|--version|-v) cmd_version ;;
        help|--help|-h) show_help ;;
        *)
            echo -e "${RED}Error: Unknown command '$command'${NC}"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

main "$@"
