#!/bin/bash
# Mirror Bridge Auto - Auto-discover and bind all classes in a directory
# Usage: mirror_bridge_auto <src_dir> --module <name> [options]

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Default configuration
OUTPUT_DIR="build"
MODULE_NAME=""
SRC_DIR=""
VERBOSE=0
KEEP_GENERATED=0
USE_PCH=""
PCH_PATH=""
FORCE_REBUILD=0
GENERATE_STUBS=0

# Help message
show_help() {
    cat << EOF
Mirror Bridge Auto - Auto-discover and bind classes from directory

Usage: mirror_bridge_auto <src_dir> --module <name> [options]

Options:
  --module NAME           Python module name (required)
  -o, --output-dir DIR    Output directory for .so file (default: build/)
  -k, --keep-generated    Keep generated binding .cpp file
  -v, --verbose           Show compilation output
  --use-pch [PATH]        Use precompiled header (optional path to .gch file)
  -f, --force             Force rebuild even if sources haven't changed
  --stubs                 Generate .pyi type stub file for IDE support
  -h, --help              Show this help message

Change Detection:
  By default, mirror_bridge_auto tracks source file changes and only
  recompiles when header files have been modified since the last build.
  Use --force to bypass this check and always rebuild.

Auto-Discovery:
  Scans all .hpp/.h files in src_dir and automatically binds all
  struct/class definitions found, including those inside namespaces.

  Opt-out: Add comment "MIRROR_BRIDGE_SKIP" before class:
    // MIRROR_BRIDGE_SKIP
    struct InternalClass { ... };

Examples:
  # Basic usage
  mirror_bridge_auto src/ --module my_module

  # With precompiled header (3-6x faster compilation!)
  mirror_bridge_auto src/ --module my_module --use-pch

  # With custom PCH path
  mirror_bridge_auto src/ --module my_module --use-pch build/pch.gch

This generates: build/my_module.so containing ALL classes from src/

Performance:
  Without PCH: ~500-1700ms compilation
  With PCH:    ~200-250ms compilation (3-6x faster!)

EOF
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        --module)
            MODULE_NAME="$2"
            shift 2
            ;;
        -o|--output-dir)
            OUTPUT_DIR="$2"
            shift 2
            ;;
        -k|--keep-generated)
            KEEP_GENERATED=1
            shift
            ;;
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        --use-pch)
            USE_PCH="1"
            # Check if next arg is a path or another option
            if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
                PCH_PATH="$2"
                shift 2
            else
                # Auto-detect PCH in common locations
                PCH_PATH="auto"
                shift
            fi
            ;;
        -f|--force)
            FORCE_REBUILD=1
            shift
            ;;
        --stubs)
            GENERATE_STUBS=1
            shift
            ;;
        -*)
            echo -e "${RED}Error: Unknown option $1${NC}"
            show_help
            exit 1
            ;;
        *)
            if [ -z "$SRC_DIR" ]; then
                SRC_DIR="$1"
            else
                echo -e "${RED}Error: Multiple source directories specified${NC}"
                exit 1
            fi
            shift
            ;;
    esac
done

# Validate input
if [ -z "$SRC_DIR" ]; then
    echo -e "${RED}Error: No source directory specified${NC}"
    show_help
    exit 1
fi

if [ -z "$MODULE_NAME" ]; then
    echo -e "${RED}Error: No module name specified (use --module)${NC}"
    show_help
    exit 1
fi

if [ ! -d "$SRC_DIR" ]; then
    echo -e "${RED}Error: Directory not found: $SRC_DIR${NC}"
    exit 1
fi

# Get absolute paths
SRC_DIR=$(realpath "$SRC_DIR")
OUTPUT_DIR=$(realpath "$OUTPUT_DIR")

mkdir -p "$OUTPUT_DIR"

echo -e "${BLUE}Mirror Bridge Auto-Discovery${NC}"
echo -e "${BLUE}============================${NC}"
echo ""
echo -e "Source directory: ${YELLOW}$SRC_DIR${NC}"
echo -e "Module name:      ${YELLOW}$MODULE_NAME${NC}"
echo ""

# Find all header files
HEADER_FILES=$(find "$SRC_DIR" -type f \( -name "*.hpp" -o -name "*.h" \) | sort)

if [ -z "$HEADER_FILES" ]; then
    echo -e "${RED}Error: No header files found in $SRC_DIR${NC}"
    exit 1
fi

# Change detection: check if rebuild is needed
OUTPUT_FILE="$OUTPUT_DIR/${MODULE_NAME}.so"
NEEDS_REBUILD=0

if [ $FORCE_REBUILD -eq 1 ]; then
    NEEDS_REBUILD=1
    echo -e "${YELLOW}Force rebuild requested${NC}"
elif [ ! -f "$OUTPUT_FILE" ]; then
    NEEDS_REBUILD=1
    echo -e "${YELLOW}Output file not found, building...${NC}"
else
    # Check if any header file is newer than the output
    OUTPUT_MTIME=$(stat -c %Y "$OUTPUT_FILE" 2>/dev/null || stat -f %m "$OUTPUT_FILE" 2>/dev/null)

    while IFS= read -r header_file; do
        HEADER_MTIME=$(stat -c %Y "$header_file" 2>/dev/null || stat -f %m "$header_file" 2>/dev/null)
        if [ "$HEADER_MTIME" -gt "$OUTPUT_MTIME" ]; then
            NEEDS_REBUILD=1
            rel_path=$(realpath --relative-to="$SRC_DIR" "$header_file")
            echo -e "${YELLOW}Source changed: $rel_path${NC}"
            break
        fi
    done <<< "$HEADER_FILES"

    if [ $NEEDS_REBUILD -eq 0 ]; then
        echo -e "${GREEN}✓ Up to date: ${MODULE_NAME}.so${NC}"
        echo -e "${BLUE}No source files changed since last build. Use --force to rebuild anyway.${NC}"
        exit 0
    fi
fi

echo ""
echo -e "${YELLOW}Scanning for classes...${NC}"

# Python script for symbol discovery (more maintainable than AWK)
DISCOVER_SCRIPT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/scripts/discover_symbols.py"

# Discover classes with namespace support
# Output format: "qualified_name|simple_name|header_path"
discover_classes() {
    local header_file="$1"
    local rel_path="$2"
    python3 "$DISCOVER_SCRIPT" --classes "$header_file" "$rel_path"
}

# Discover free functions in specified namespaces
# Output format: "qualified_name|simple_name|header_path"
discover_functions() {
    local header_file="$1"
    local rel_path="$2"
    local target_namespaces="$3"  # Pipe-separated list of namespaces to scan
    python3 "$DISCOVER_SCRIPT" --functions "$header_file" "$rel_path" "$target_namespaces"
}

declare -a QUALIFIED_NAMES
declare -a SIMPLE_NAMES
declare -a HEADERS
declare -A NAMESPACES  # Track unique namespaces

while IFS= read -r header_file; do
    rel_path=$(realpath --relative-to="$SRC_DIR" "$header_file")

    # Check if file should be skipped entirely
    if grep -q "MIRROR_BRIDGE_SKIP_FILE" "$header_file" 2>/dev/null; then
        if [ $VERBOSE -eq 1 ]; then
            echo -e "${BLUE}  Skipping file: $rel_path (MIRROR_BRIDGE_SKIP_FILE)${NC}"
        fi
        continue
    fi

    # Discover classes with namespace support
    while IFS='|' read -r qualified simple header; do
        if [ -n "$qualified" ]; then
            QUALIFIED_NAMES+=("$qualified")
            SIMPLE_NAMES+=("$simple")
            HEADERS+=("$header")

            # Extract namespace part
            if [[ "$qualified" == *"::"* ]]; then
                ns="${qualified%::*}"
                NAMESPACES["$ns"]=1
            fi

            echo -e "  ${GREEN}✓${NC} Found: $qualified in $header"
        fi
    done < <(discover_classes "$header_file" "$rel_path")

done <<< "$HEADER_FILES"

# Check if any classes found
if [ ${#QUALIFIED_NAMES[@]} -eq 0 ]; then
    echo -e "${RED}Error: No classes found in $SRC_DIR${NC}"
    echo -e "${YELLOW}Tip: Classes must be defined as 'struct ClassName' or 'class ClassName'${NC}"
    exit 1
fi

echo ""
echo -e "${GREEN}Discovered ${#QUALIFIED_NAMES[@]} classes${NC}"

# Phase 2: Discover free functions in namespaces that contain classes
declare -a FUNC_QUALIFIED_NAMES
declare -a FUNC_SIMPLE_NAMES
declare -a FUNC_HEADERS
declare -A FUNC_SEEN  # Track unique functions to avoid duplicates

if [ ${#NAMESPACES[@]} -gt 0 ]; then
    echo ""
    echo -e "${YELLOW}Scanning for free functions in discovered namespaces...${NC}"

    # Build pipe-separated list of namespaces
    NS_LIST=""
    for ns in "${!NAMESPACES[@]}"; do
        if [ -n "$NS_LIST" ]; then
            NS_LIST="$NS_LIST|$ns"
        else
            NS_LIST="$ns"
        fi
    done

    if [ $VERBOSE -eq 1 ]; then
        echo -e "${BLUE}  Target namespaces: $NS_LIST${NC}"
    fi

    # Scan all headers for functions
    while IFS= read -r header_file; do
        rel_path=$(realpath --relative-to="$SRC_DIR" "$header_file")

        # Skip files marked to skip
        if grep -q "MIRROR_BRIDGE_SKIP_FILE" "$header_file" 2>/dev/null; then
            continue
        fi

        while IFS='|' read -r qualified simple header; do
            if [ -n "$qualified" ] && [ -z "${FUNC_SEEN[$qualified]}" ]; then
                FUNC_QUALIFIED_NAMES+=("$qualified")
                FUNC_SIMPLE_NAMES+=("$simple")
                FUNC_HEADERS+=("$header")
                FUNC_SEEN["$qualified"]=1
                echo -e "  ${GREEN}✓${NC} Found function: $qualified in $header"
            fi
        done < <(discover_functions "$header_file" "$rel_path" "$NS_LIST")

    done <<< "$HEADER_FILES"

    if [ ${#FUNC_QUALIFIED_NAMES[@]} -gt 0 ]; then
        echo -e "${GREEN}Discovered ${#FUNC_QUALIFIED_NAMES[@]} free functions${NC}"
    else
        echo -e "${BLUE}No free functions found in discovered namespaces${NC}"
    fi
fi

echo ""

# Generate binding file
GENERATED_FILE="$OUTPUT_DIR/${MODULE_NAME}_binding.cpp"
echo -e "${YELLOW}Generating binding file...${NC}"

cat > "$GENERATED_FILE" << EOF
// Auto-generated by mirror_bridge_auto
// Source: $SRC_DIR
// Generated: $(date)

#include "mirror_bridge.hpp"
EOF

# Add header includes (unique only)
declare -A included
for header in "${HEADERS[@]}"; do
    if [ -z "${included[$header]}" ]; then
        echo "#include \"$header\"" >> "$GENERATED_FILE"
        included[$header]=1
    fi
done

echo "" >> "$GENERATED_FILE"

# Generate module with all class and function bindings
echo "MIRROR_BRIDGE_MODULE($MODULE_NAME," >> "$GENERATED_FILE"

# Bind classes first
for i in "${!QUALIFIED_NAMES[@]}"; do
    qualified_name="${QUALIFIED_NAMES[$i]}"
    simple_name="${SIMPLE_NAMES[$i]}"
    # Use qualified name for C++ type, simple name for Python exposure
    echo "    mirror_bridge::bind_class<$qualified_name>(m, \"$simple_name\");" >> "$GENERATED_FILE"
done

# Bind free functions
for i in "${!FUNC_QUALIFIED_NAMES[@]}"; do
    qualified_name="${FUNC_QUALIFIED_NAMES[$i]}"
    simple_name="${FUNC_SIMPLE_NAMES[$i]}"
    echo "    mirror_bridge::bind_function<&$qualified_name>(m, \"$simple_name\");" >> "$GENERATED_FILE"
done

echo ")" >> "$GENERATED_FILE"

echo -e "${GREEN}✓ Generated: $GENERATED_FILE${NC}"
echo ""

# Build using mirror_bridge_build
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD_SCRIPT="$SCRIPT_DIR/mirror_bridge_build"

if [ ! -x "$BUILD_SCRIPT" ]; then
    echo -e "${RED}Error: mirror_bridge_build not found or not executable${NC}"
    exit 1
fi

# Build command with source directory as include path
BUILD_CMD="$BUILD_SCRIPT $GENERATED_FILE -I $SRC_DIR -o $OUTPUT_DIR"
if [ $VERBOSE -eq 1 ]; then
    BUILD_CMD="$BUILD_CMD -v"
fi

# Add PCH support if requested
if [ -n "$USE_PCH" ]; then
    if [ "$PCH_PATH" = "auto" ]; then
        # Auto-detect PCH in common locations
        for pch_candidate in \
            "build/mirror_bridge_pch.hpp.gch" \
            "mirror_bridge_pch.hpp.gch" \
            "$OUTPUT_DIR/mirror_bridge_pch.hpp.gch" \
            "$SCRIPT_DIR/build/mirror_bridge_pch.hpp.gch"
        do
            if [ -f "$pch_candidate" ]; then
                PCH_PATH="$pch_candidate"
                echo -e "${GREEN}✓ Found PCH: $PCH_PATH${NC}"
                break
            fi
        done

        if [ "$PCH_PATH" = "auto" ]; then
            echo -e "${YELLOW}Warning: No PCH found in common locations${NC}"
            echo -e "${YELLOW}Creating PCH now (one-time setup)...${NC}"
            mkdir -p "$OUTPUT_DIR"
            PCH_PATH="$OUTPUT_DIR/mirror_bridge_pch.hpp.gch"

            # Create PCH with same flags as will be used for compilation
            clang++ -std=c++2c -freflection -freflection-latest \
                -fPIC -stdlib=libc++ \
                $(python3-config --includes) \
                -O3 -DNDEBUG \
                -x c++-header "$SCRIPT_DIR/mirror_bridge_pch.hpp" \
                -o "$PCH_PATH" 2>&1 | grep -v "mixture of designated" || true

            if [ -f "$PCH_PATH" ]; then
                echo -e "${GREEN}✓ PCH created: $PCH_PATH${NC}"
            else
                echo -e "${RED}Error: Failed to create PCH${NC}"
                USE_PCH=""
            fi
        fi
    fi

    if [ -n "$USE_PCH" ]; then
        BUILD_CMD="$BUILD_CMD --use-pch $PCH_PATH"
    fi
fi

eval "$BUILD_CMD"

# Clean up generated file unless requested to keep
if [ $KEEP_GENERATED -eq 0 ]; then
    rm "$GENERATED_FILE"
    echo -e "${BLUE}Cleaned up generated file${NC}"
else
    echo -e "${BLUE}Generated file kept: $GENERATED_FILE${NC}"
fi

# Generate type stubs if requested
if [ $GENERATE_STUBS -eq 1 ]; then
    STUB_SCRIPT="$SCRIPT_DIR/scripts/generate_stubs.py"
    if [ -f "$STUB_SCRIPT" ]; then
        echo ""
        echo -e "${YELLOW}Generating type stubs...${NC}"

        # Find the compiled module
        SO_FILE=$(find "$OUTPUT_DIR" -name "${MODULE_NAME}*.so" | head -1)
        if [ -n "$SO_FILE" ]; then
            if python3 "$STUB_SCRIPT" "$SO_FILE" --output "$OUTPUT_DIR" 2>/dev/null; then
                echo -e "${GREEN}✓ Generated: $OUTPUT_DIR/${MODULE_NAME}.pyi${NC}"
            else
                echo -e "${YELLOW}Warning: Failed to generate stubs (module may need specific imports)${NC}"
            fi
        fi
    else
        echo -e "${YELLOW}Warning: Stub generator not found: $STUB_SCRIPT${NC}"
    fi
fi

echo ""
echo -e "${GREEN}✓ Successfully auto-discovered and built: ${MODULE_NAME}.so${NC}"
echo -e "${GREEN}  Classes bound: ${#QUALIFIED_NAMES[@]}${NC}"
if [ ${#FUNC_QUALIFIED_NAMES[@]} -gt 0 ]; then
    echo -e "${GREEN}  Functions bound: ${#FUNC_QUALIFIED_NAMES[@]}${NC}"
fi
if [ $GENERATE_STUBS -eq 1 ] && [ -f "$OUTPUT_DIR/${MODULE_NAME}.pyi" ]; then
    echo -e "${GREEN}  Type stubs: ${MODULE_NAME}.pyi${NC}"
fi
echo ""
echo -e "${BLUE}Usage from Python:${NC}"
echo -e "  import sys"
echo -e "  sys.path.insert(0, '$OUTPUT_DIR')"
echo -e "  import $MODULE_NAME"
echo ""
echo -e "  # Classes available:"
for i in "${!SIMPLE_NAMES[@]}"; do
    simple_name="${SIMPLE_NAMES[$i]}"
    qualified_name="${QUALIFIED_NAMES[$i]}"
    if [ "$simple_name" != "$qualified_name" ]; then
        echo -e "  # - $simple_name (C++: $qualified_name)"
    else
        echo -e "  # - $simple_name"
    fi
done
if [ ${#FUNC_QUALIFIED_NAMES[@]} -gt 0 ]; then
    echo ""
    echo -e "  # Functions available:"
    for i in "${!FUNC_SIMPLE_NAMES[@]}"; do
        simple_name="${FUNC_SIMPLE_NAMES[$i]}"
        qualified_name="${FUNC_QUALIFIED_NAMES[$i]}"
        if [ "$simple_name" != "$qualified_name" ]; then
            echo -e "  # - $simple_name() (C++: $qualified_name)"
        else
            echo -e "  # - $simple_name()"
        fi
    done
fi
echo ""
